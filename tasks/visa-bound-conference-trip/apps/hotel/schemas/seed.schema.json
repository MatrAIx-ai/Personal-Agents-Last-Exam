{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:roomline:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "guest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        }
      },
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false
    },
    "currency": {
      "const": "EUR"
    },
    "payment_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "hotels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "neighborhood": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "distance_note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "room": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone of the hotel, for example Europe/Paris."
          },
          "check_in_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Local wall-clock time HH:MM at the hotel."
          },
          "check_out_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Local wall-clock time HH:MM at the hotel."
          },
          "rates": {
            "type": "object",
            "properties": {
              "refundable": {
                "type": "object",
                "properties": {
                  "nightly_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  },
                  "free_cancellation_hours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 720,
                    "description": "Full refund until this many hours before arrival (check-in date at check_in_time)."
                  }
                },
                "required": [
                  "nightly_cents",
                  "free_cancellation_hours"
                ],
                "additionalProperties": false
              },
              "non_refundable": {
                "type": "object",
                "properties": {
                  "nightly_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  }
                },
                "required": [
                  "nightly_cents"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "refundable",
              "non_refundable"
            ],
            "additionalProperties": false
          },
          "high_demand_nights": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Local date at the hotel, YYYY-MM-DD."
            },
            "maxItems": 366,
            "uniqueItems": true,
            "description": "Nights on which a refundable booking comes back with an offer to switch to the non-refundable rate."
          },
          "sold_out_nights": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Local date at the hotel, YYYY-MM-DD."
            },
            "maxItems": 366,
            "uniqueItems": true,
            "description": "Nights that cannot be booked in either plan."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "name",
          "city",
          "neighborhood",
          "distance_note",
          "room",
          "timezone",
          "check_in_time",
          "check_out_time",
          "rates",
          "high_demand_nights",
          "sold_out_nights",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "confirmation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "hotel_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "hotel_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "check_in": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Local date at the hotel, YYYY-MM-DD."
          },
          "check_out": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Local date at the hotel, YYYY-MM-DD."
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "plan": {
            "enum": [
              "refundable",
              "non_refundable"
            ]
          },
          "nightly_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Euro cents."
          },
          "total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Euro cents."
          },
          "paid_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Euro cents."
          },
          "payment_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "free_cancellation_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Full refund if cancelled at or before this instant; null on the non-refundable plan."
          },
          "status": {
            "enum": [
              "confirmed",
              "pending_rate_switch",
              "cancelled"
            ]
          },
          "rate_switch": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "accepted",
                      "declined",
                      "expired",
                      "withdrawn"
                    ]
                  },
                  "proposed_plan": {
                    "const": "non_refundable"
                  },
                  "proposed_nightly_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  },
                  "proposed_total_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  },
                  "high_demand_nights": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                      "description": "Local date at the hotel, YYYY-MM-DD."
                    },
                    "maxItems": 366,
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "offered_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "resolved_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "status",
                  "proposed_plan",
                  "proposed_nightly_cents",
                  "proposed_total_cents",
                  "high_demand_nights",
                  "offered_at",
                  "expires_at",
                  "resolved_at",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "cancellation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "rule": {
                    "enum": [
                      "free",
                      "late",
                      "non_refundable"
                    ]
                  },
                  "refund_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  },
                  "fee_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000,
                    "description": "Euro cents."
                  }
                },
                "required": [
                  "at",
                  "rule",
                  "refund_cents",
                  "fee_cents"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "charge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 100
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "account_id",
          "confirmation",
          "hotel_id",
          "hotel_name",
          "city",
          "check_in",
          "check_out",
          "nights",
          "plan",
          "nightly_cents",
          "total_cents",
          "paid_cents",
          "payment_label",
          "free_cancellation_until",
          "status",
          "rate_switch",
          "cancellation",
          "charge_ids",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reservation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "enum": [
              "charge",
              "refund"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": -100000000,
            "maximum": 100000000,
            "description": "Euro cents; refunds are negative."
          },
          "payment_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "account_id",
          "at",
          "reservation_id",
          "kind",
          "amount_cents",
          "payment_label",
          "description"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "events_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "event_id",
          "at",
          "operation",
          "affected_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "guest",
    "currency",
    "payment_labels",
    "hotels",
    "reservations",
    "charges",
    "events_applied"
  ],
  "additionalProperties": false
}
