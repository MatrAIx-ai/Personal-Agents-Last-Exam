{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:harbor:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "member_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "mail_account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "balance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "opening",
              "redeem",
              "refund",
              "transfer_in",
              "expire"
            ]
          },
          "points": {
            "type": "integer",
            "minimum": -100000000,
            "maximum": 100000000
          },
          "balance_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reservation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "reservation_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "app_id": {
                    "const": "waypoint"
                  },
                  "account_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "object_type": {
                    "enum": [
                      "transfer",
                      "combine"
                    ]
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "sent_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "app_id",
                  "account_id",
                  "object_type",
                  "object_id",
                  "message_id",
                  "sent_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "at",
          "kind",
          "points",
          "balance_after",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "payment_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Opaque payment label, one of the account's payment_labels."
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque payment label, one of the account's payment_labels."
          },
          "amount_cents": {
            "type": "integer",
            "minimum": -100000000,
            "maximum": 100000000,
            "description": "Signed amount; refunds are negative."
          },
          "currency": {
            "const": "USD"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reservation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "reservation_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "at",
          "label",
          "amount_cents",
          "currency",
          "description",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "kind": {
            "enum": [
              "booking_confirmed",
              "category_change",
              "expiry_warning"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object_type": {
                    "enum": [
                      "reservation",
                      "hotel",
                      "account"
                    ]
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "object_type",
                  "object_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "history",
          "kind",
          "title",
          "body",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "inactivity_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "forfeited_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "award_chart": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "points_per_night": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "points_cash": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "cash_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  }
                },
                "required": [
                  "points",
                  "cash_cents"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "category",
          "points_per_night",
          "points_cash"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "hotels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone of the hotel; check-in dates and blackout dates are local dates there."
          },
          "category": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "Category before any listed change takes effect."
          },
          "category_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "effective_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "announced_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "category",
                "effective_at",
                "announced_at"
              ],
              "additionalProperties": false
            },
            "maxItems": 20,
            "description": "Announced changes in effective_at order."
          },
          "cash_rate_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "blackout_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Calendar date YYYY-MM-DD, read in the hotel's own time zone."
            },
            "uniqueItems": true,
            "maxItems": 366
          }
        },
        "required": [
          "id",
          "name",
          "city",
          "timezone",
          "category",
          "category_changes",
          "cash_rate_cents",
          "blackout_dates"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "category_cap": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "expires_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Last allowed check-in date."
          },
          "status": {
            "enum": [
              "active",
              "used",
              "expired"
            ]
          },
          "reservation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "category_cap",
          "expires_on",
          "status",
          "reservation_id",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "confirmation": {
            "type": "string",
            "pattern": "^HH[0-9A-F]{8}$"
          },
          "hotel_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "check_in": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD, read in the hotel's own time zone."
          },
          "check_out": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD, read in the hotel's own time zone."
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "status": {
            "enum": [
              "confirmed",
              "cancelled"
            ]
          },
          "payment": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "points",
                  "certificate",
                  "points_cash",
                  "cash"
                ]
              },
              "certificate_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payment_label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "Opaque payment label, one of the account's payment_labels."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "method",
              "certificate_id",
              "payment_label"
            ],
            "additionalProperties": false
          },
          "category_locked": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "Category in effect when the reservation was booked; later changes do not reprice it."
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "cash_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "charge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 10
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "confirmation",
          "hotel_id",
          "check_in",
          "check_out",
          "nights",
          "status",
          "payment",
          "category_locked",
          "points",
          "cash_cents",
          "charge_ids",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "member_number",
    "mail_account_id",
    "balance",
    "ledger",
    "payment_labels",
    "charges",
    "notices",
    "last_activity_at",
    "inactivity_months",
    "forfeited_at",
    "award_chart",
    "hotels",
    "certificates",
    "reservations"
  ],
  "additionalProperties": false
}
