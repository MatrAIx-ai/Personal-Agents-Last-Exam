    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "portal.staff_reply"
        },
        "payload": {
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "author": {
              "type": "object",
              "properties": {
                "role": {
                  "enum": [
                    "patient",
                    "clinic",
                    "nurse_line",
                    "billing_office",
                    "provider",
                    "system"
                  ]
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "role",
                "display_name"
              ],
              "additionalProperties": false
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
                  },
                  "mime_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "base64": {
                    "type": "string",
                    "maxLength": 1398104
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "filename",
                  "mime_type",
                  "base64",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "maxItems": 2
            }
          },
          "required": [
            "thread_id",
            "author",
            "body"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
