{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "offer.quote_upsert"
        },
        "payload": {
          "$ref": "business.schema.json#/$defs/offer"
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "offer.revoke"
        },
        "payload": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "offer_episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "reason": {
              "const": "seller_revoked"
            }
          },
          "required": [
            "account_id",
            "offer_episode_id",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "offer.expire_due"
        },
        "payload": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "account_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
