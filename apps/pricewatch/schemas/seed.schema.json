{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "id_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/product"
      }
    },
    "sellers": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/seller"
      }
    },
    "eligibility_sources": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/eligibility_source"
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/offer"
      }
    },
    "offer_states": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/offer_state"
      }
    },
    "watches": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/watch"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/candidate"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/transition"
      }
    },
    "event_receipts": {
      "type": "array",
      "items": {
        "$ref": "business.schema.json#/$defs/event_receipt"
      }
    }
  },
  "required": [
    "account_id",
    "id_sequence",
    "products",
    "sellers",
    "eligibility_sources",
    "offers",
    "offer_states",
    "watches",
    "candidates",
    "transitions",
    "event_receipts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
