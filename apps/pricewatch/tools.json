  {
    "name": "pricewatch.watch.get",
    "description": "Read one server watch ID, paginated candidate projections and append-only transition history; no read receipt or business mutation.",
    "read_only": true,
    "scope": "pricewatch.watch.get",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "watch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "candidate_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "history_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
