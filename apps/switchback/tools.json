            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "hold_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "primary_occupant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "equipment_id": {
          "anyOf": [
