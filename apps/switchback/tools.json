        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "switchback"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 2000
        }
      },
