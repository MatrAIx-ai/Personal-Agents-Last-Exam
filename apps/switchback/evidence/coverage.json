{
  "schema": "switchback.coverage.v1",
  "scope": "Environment dataset coverage of the records each delivered Switchback fixture loads with env.load_seed (and the Mail seed used by the publisher), counted over represented occurrence dates.",
  "window": {
    "from": "2025-01-01",
    "to": "2026-12-31"
  },
  "time_zone": "America/Phoenix",
  "time_zone_note": "Facilities keep fixed UTC offsets (-06:00, -07:00 or -08:00, no daylight saving). Timestamps are normalized to America/Phoenix (UTC-07:00 all year) before taking the date; date-only fields (stay and claim nights) are facility-local calendar dates and are taken as they are. date_shift_vs_facility_offset counts records whose America/Phoenix date differs from the date in their own offset.",
  "provenance": "All records are synthetic: written by fixtures/generate.cjs from fixed seeds (claim instants drawn once from OS entropy into fixtures/evaluator/). No real facility, person, payment or Recreation.gov record is included, and none of these records is an observed fact.",
  "fields": [
    {
      "collection": "reservations",
      "field": "created_at",
      "meaning": "booking made (charge receipt time)"
    },
    {
      "collection": "reservations[].history",
      "field": "at",
      "meaning": "lifecycle event after booking: check-in, completion, cancellation, no-show release, change, late-arrival notice (the \"confirmed\" row repeats created_at and is not counted again)"
    },
    {
      "collection": "reservations[].nights",
      "field": "date (date-only, facility-local)",
      "meaning": "a night the account holder stayed or is booked to stay (cancelled stays excluded)"
    },
    {
      "collection": "payments",
      "field": "created_at",
      "meaning": "charge or refund issued"
    },
    {
      "collection": "alerts",
      "field": "posted_at",
      "meaning": "facility alert posted"
    },
    {
      "collection": "closures",
      "field": "ordered_at",
      "meaning": "closure ordered"
    },
    {
      "collection": "claims",
      "field": "claimed_at",
      "meaning": "another booker took open nights"
    },
    {
      "collection": "claims[].nights",
      "field": "date (date-only, facility-local)",
      "meaning": "a night another booker holds"
    },
    {
      "collection": "equipment",
      "field": "updated_at",
      "meaning": "saved equipment last edited"
    },
    {
      "collection": "companions",
      "field": "updated_at",
      "meaning": "saved companion last edited"
    },
    {
      "collection": "messages (Mail)",
      "field": "received_at",
      "meaning": "Mail message in the seeded inbox"
    }
  ],
  "excluded": [
    {
      "field": "reservations.updated_at",
      "reason": "repeats the last history row"
    },
    {
      "field": "reservations.arrival, departure",
      "reason": "stay bounds; the nights themselves are counted"
    },
    {
      "field": "payments.posts_at",
      "reason": "derived posting date (refunds post three days after created_at); counted once through created_at"
    },
    {
      "field": "alerts.from, to, cancelled_at; alerts.revisions",
      "reason": "validity window and its end, not an occurrence"
    },
    {
      "field": "closures.from, to",
      "reason": "validity window of the closure, not an occurrence"
    },
    {
      "field": "wallet.cards exp_month, exp_year",
      "reason": "expiry deadline"
    },
    {
      "field": "holds.expires_at, previews.expires_at, notices",
      "reason": "deadlines and run records; empty in every seed"
    },
    {
      "field": "facilities, sites, policies",
      "reason": "catalogue records with no represented date"
    },
    {
      "field": "fixtures/schedules/*.json, fixtures/evaluator/*.json",
      "reason": "scenario events applied during a run, not loaded history; listed separately below and not counted"
    }
  ],
  "invalid_dates": "A value that does not parse as a date is counted under invalid and shown; there are none when invalid is 0.",
