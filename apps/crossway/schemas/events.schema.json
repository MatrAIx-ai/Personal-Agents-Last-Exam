{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crossway scenario events",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "crossway.toll.posted"
        },
        "payload": {
          "type": "object",
          "properties": {
            "toll_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "plaza_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "read": {
              "enum": [
                "transponder",
                "plate"
              ]
            },
            "plate": {
              "type": "string",
              "pattern": "^[A-Za-z0-9 -]{2,10}$"
            },
            "transponder_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "class": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          },
          "required": [
            "toll_id",
            "plaza_id",
            "read",
            "plate",
            "transponder_id",
            "class"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "crossway.card.status_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "card_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "status": {
              "enum": [
                "active",
                "declined",
                "closed"
              ]
            }
          },
          "required": [
            "card_id",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "crossway.dispute.decided"
        },
        "payload": {
          "type": "object",
          "properties": {
            "notice_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "grant_if": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reason": {
                    "enum": [
                      "sold_or_not_in_possession",
                      "paid_by_rental_agency",
                      "transponder_malfunction",
                      "not_my_plate"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "app_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                        },
                        "account_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                        },
                        "object_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                        }
                      },
                      "required": [
                        "app_id",
                        "account_id",
                        "object_id"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 10
                  }
                },
                "required": [
                  "reason",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            }
          },
          "required": [
            "notice_id",
            "grant_if"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
