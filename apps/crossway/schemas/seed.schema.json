{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crossway account seed",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "holder": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "display_name"
      ],
      "additionalProperties": false
    },
    "opened_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authority": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "time_zone": {
          "const": "America/New_York"
        },
        "plazas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "road": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "account_cents": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "maxItems": 9,
                "minItems": 1
              },
              "mail_cents": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "maxItems": 9,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "road",
              "account_cents",
              "mail_cents"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "rental_agencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "plates_on_other_accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,8}$"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "properties": {
            "vehicle_classes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "class": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "class",
                  "label"
                ],
                "additionalProperties": false
              },
              "maxItems": 9,
              "minItems": 1
            },
            "late_fee_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "notice_due_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "escalated_due_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "dispute_window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "denial_due_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "preview_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "temporary_plate_max_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "topup_min_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "topup_max_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "replenish_min_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "replenish_max_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "threshold_min_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "threshold_max_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            }
          },
          "required": [
            "vehicle_classes",
            "late_fee_cents",
            "notice_due_days",
            "escalated_due_days",
            "dispute_window_days",
            "denial_due_days",
            "preview_minutes",
            "temporary_plate_max_days",
            "topup_min_cents",
            "topup_max_cents",
            "replenish_min_cents",
            "replenish_max_cents",
            "threshold_min_cents",
            "threshold_max_cents"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "time_zone",
        "plazas",
        "rental_agencies",
        "plates_on_other_accounts",
        "policy"
      ],
      "additionalProperties": false
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "holder_person_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "holder_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "exp_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "exp_year": {
            "type": "integer",
            "minimum": 2020,
            "maximum": 2100
          },
          "status": {
            "enum": [
              "active",
              "declined",
              "closed"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "at",
                "action"
              ]
            },
            "maxItems": 500
          }
