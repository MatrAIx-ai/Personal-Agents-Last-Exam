  {
    "name": "meeting-poll.list",
    "description": "List visible meeting polls, optionally searching by title.",
    "read_only": true,
    "scope": "meeting-poll.list",
    "resource_target": "bound account and visible poll",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "meeting-poll"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4000
              },
              "location": {
                "type": "string",
                "minLength": 0,
                "maxLength": 200
              },
              "organizer_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "participant_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "minItems": 2,
                "maxItems": 12,
                "uniqueItems": true
              },
              "deadline": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "draft",
                  "open",
                  "closed",
                  "finalized",
                  "cancelled"
                ]
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "start",
                    "end",
                    "timezone",
                    "active"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 100
              },
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "person_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "votes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slot_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                          },
                          "value": {
                            "enum": [
                              "yes",
                              "if-needed",
                              "no"
                            ]
                          }
                        },
                        "required": [
                          "slot_id",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0,
                      "maxItems": 10
                    },
                    "withdrawn": {
                      "type": "boolean"
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "person_id",
                    "votes",
                    "withdrawn",
                    "at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "meetings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "slot_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "status": {
                      "enum": [
                        "active",
                        "superseded",
                        "cancelled"
                      ]
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "slot_id",
                    "status",
                    "at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 100
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "actor_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "action",
                    "actor_id",
                    "at",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "viewer_role": {
                "enum": [
                  "organizer",
                  "participant"
                ]
              },
              "viewer_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "effective_status": {
                "enum": [
                  "draft",
                  "open",
                  "closed",
                  "finalized",
                  "cancelled"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "location",
              "organizer_id",
              "participant_ids",
              "deadline",
              "status",
              "slots",
              "responses",
              "meetings",
              "history",
              "created_at",
              "updated_at",
              "viewer_role",
              "viewer_id",
              "effective_status"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "items"
      ],
      "additionalProperties": false
    }
