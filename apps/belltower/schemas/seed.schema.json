{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Belltower world and account records",
  "description": "History accepted by env.load_seed and kept as App data. World records (sources, an area tree, items with every revision) and one reader account (preferences, follow rules, read marks, clippings with their history, notifications, activity). Everything in a seed has already been published and received; new information arrives only through events. Time-based states are not stored: a public notice carries its effective period and a notification its release time, and both are read against the environment clock.",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "official",
              "newsroom",
              "aggregator"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "level": {
            "enum": [
              "city",
              "district",
              "neighbourhood"
            ]
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "parent_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "enum": [
              "article",
              "notice"
            ]
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "type": {
                  "enum": [
                    "original",
                    "update",
                    "correction",
                    "retraction"
                  ]
                },
                "published_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "received_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "headline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "water",
                      "power",
                      "roads",
                      "transit",
                      "schools",
                      "libraries",
                      "health",
                      "safety",
                      "weather",
                      "government",
                      "community",
                      "business"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 12,
                  "uniqueItems": true
                },
                "area_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true
                },
                "priority": {
                  "enum": [
                    "routine",
                    "important",
                    "urgent"
                  ]
                },
                "effective": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "format": "date-time"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "based_on": {
                  "type": "object",
                  "properties": {
                    "item_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 999
                    },
                    "relation": {
                      "enum": [
                        "copy",
                        "report"
                      ]
                    }
                  },
                  "required": [
                    "item_id",
                    "revision",
                    "relation"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "number",
                "type",
                "published_at",
                "received_at"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "id",
          "source_id",
          "kind",
          "revisions"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "preferences": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "required": [
            "enabled",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "digest_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "corrections": {
          "enum": [
            "as_item",
            "immediate"
          ]
        },
        "email_notices": {
          "type": "boolean"
        }
      },
      "required": [
        "timezone",
        "quiet_hours",
        "digest_time",
        "corrections",
        "email_notices"
      ],
      "additionalProperties": false
    },
    "follows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "area_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "topics": {
            "type": "array",
            "items": {
              "enum": [
                "water",
                "power",
                "roads",
                "transit",
                "schools",
                "libraries",
                "health",
                "safety",
                "weather",
                "government",
                "community",
                "business"
              ]
            },
            "maxItems": 12,
            "uniqueItems": true
          },
          "min_priority": {
            "enum": [
              "routine",
              "important",
              "urgent"
            ]
          },
          "delivery": {
            "enum": [
              "immediate",
              "digest"
            ]
          },
          "paused": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "source_ids",
          "area_ids",
          "topics",
          "min_priority",
          "delivery",
          "paused",
          "created_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "read_marks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "read_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "item_id",
          "revision",
          "read_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 20000
    },
    "clippings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "linked_object": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "object_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              }
            },
            "required": [
              "app_id",
              "object_type",
              "object_id"
            ],
            "additionalProperties": false
          },
          "watch": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "replaced_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "linked_object": {
                  "type": "object",
                  "properties": {
                    "app_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "object_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "object_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 150
                    }
                  },
                  "required": [
                    "app_id",
                    "object_type",
                    "object_id"
                  ],
                  "additionalProperties": false
                },
                "watch": {
                  "type": "boolean"
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "replaced_at",
                "revision",
                "watch"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "item_id",
          "revision",
          "watch",
          "created_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "item.published",
              "item.updated",
              "item.corrected",
              "item.retracted"
            ]
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "release_at": {
            "type": "string",
            "format": "date-time"
          },
          "delivery": {
            "enum": [
              "immediate",
              "digest"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "enum": [
                "follow",
                "earlier_notification",
                "watched_clipping"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "matched_follow_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "supersedes": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "superseded_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "superseded_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "cause": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "wire": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "item_id",
          "revision",
          "created_at",
          "release_at",
          "delivery",
          "reasons",
          "matched_follow_ids",
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "enum": [
              "agent",
              "event"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "seq",
          "at",
          "actor",
          "action",
          "object_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 50000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "sources",
    "areas",
    "items",
    "preferences",
    "follows",
    "read_marks",
    "clippings",
    "notifications",
    "activity"
  ],
  "additionalProperties": false
}
