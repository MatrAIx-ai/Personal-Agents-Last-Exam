{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "belltower",
  "app_categories": [
    "external"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "belltower.sources.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.areas.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.items.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.items.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.follows.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.reading.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.clippings.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.notifications.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.preferences.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "belltower.follows.create",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.follows.update",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.follows.remove",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.preferences.update",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.reading.mark",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.clippings.add",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.clippings.update",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "belltower.clippings.remove",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "per-App file lock in the reference Core; no source outbox",
    "commit_confirmation": "committed + epoch/revision; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "belltower.item.published",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "belltower.item.updated",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "belltower.item.corrected",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "belltower.item.retracted",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": null,
  "notification_channels": [
    "channel.email"
  ],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": "fixtures/minimal.json",
    "status": "declared"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [],
    "implemented_storage_adapters": [],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [
      {
        "channel": "channel.email",
        "schema_id": "urn:pale:email-message:2",
        "schema_ref": "schemas/router-message.schema.json",
        "status": "implemented",
        "event_type": "org.pale.mail.notification.v1",
        "payload_schema_id": "urn:pale:email-payload:1"
      }
    ],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
