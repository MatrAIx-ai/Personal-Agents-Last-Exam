{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:pale:brightpath-student-loans:domain:1",
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"},
    "nullableId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "nullableTime":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},
    "nullableDate":{"anyOf":[{"type":"string","minLength":10,"maxLength":10},{"type":"null"}]},
    "nullableText":{"anyOf":[{"type":"string","minLength":1,"maxLength":500},{"type":"null"}]},
    "nullableMoney":{"anyOf":[{"type":"integer","minimum":0,"maximum":1000000000},{"type":"null"}]},
    "borrower":{"type":"object","properties":{"person_id":{"$ref":"#/$defs/id"},"borrower_account_id":{"$ref":"#/$defs/id"},"display_name":{"type":"string","minLength":1,"maxLength":100},"annual_income_cents":{"type":"integer","minimum":0,"maximum":1000000000},"family_size":{"type":"integer","minimum":1,"maximum":20},"filing_status":{"enum":["single","married_joint","married_separate","head_of_household"]},"irs_consent_status":{"enum":["granted","declined","expired"]},"recertification_due_on":{"type":"string","minLength":10,"maxLength":10},"masked_email":{"type":"string","minLength":3,"maxLength":120},"masked_payment_account":{"type":"string","minLength":4,"maxLength":80}},"required":["person_id","borrower_account_id","display_name","annual_income_cents","family_size","filing_status","irs_consent_status","recertification_due_on","masked_email","masked_payment_account"],"additionalProperties":false},
    "settings":{"type":"object","properties":{"mail_enabled":{"type":"boolean"},"mail_account_id":{"$ref":"#/$defs/nullableId"}},"required":["mail_enabled","mail_account_id"],"additionalProperties":false},
    "servicer":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":100},"support_phone_masked":{"type":"string","minLength":1,"maxLength":40}},"required":["id","name","support_phone_masked"],"additionalProperties":false},
    "plan":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":100},"kind":{"enum":["fixed","income_driven"]},"term_months":{"type":"integer","minimum":12,"maximum":360},"income_percent_bps":{"type":"integer","minimum":0,"maximum":10000},"poverty_base_cents":{"type":"integer","minimum":0,"maximum":100000000},"poverty_family_increment_cents":{"type":"integer","minimum":0,"maximum":100000000},"eligible_loan_types":{"type":"array","items":{"enum":["direct_subsidized","direct_unsubsidized","grad_plus","ffel"]},"minItems":1,"uniqueItems":true},"earliest_disbursement_on":{"$ref":"#/$defs/nullableDate"},"tradeoff":{"type":"string","minLength":1,"maxLength":300},"fictional_policy":{"const":true}},"required":["id","name","kind","term_months","income_percent_bps","poverty_base_cents","poverty_family_increment_cents","eligible_loan_types","earliest_disbursement_on","tradeoff","fictional_policy"],"additionalProperties":false},
    "loan":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"masked_number":{"type":"string","pattern":"^\\*{4}[0-9]{4}$"},"loan_type":{"enum":["direct_subsidized","direct_unsubsidized","grad_plus","ffel"]},"principal_cents":{"type":"integer","minimum":0,"maximum":1000000000},"accrued_interest_cents":{"type":"integer","minimum":0,"maximum":1000000000},"interest_bps":{"type":"integer","minimum":0,"maximum":3000},"disbursed_on":{"type":"string","minLength":10,"maxLength":10},"plan_id":{"$ref":"#/$defs/id"},"scheduled_payment_cents":{"type":"integer","minimum":0,"maximum":100000000},"next_due_on":{"$ref":"#/$defs/nullableDate"},"status":{"enum":["current","delinquent","deferment","forbearance","paid"]},"qualifying_payments":{"type":"integer","minimum":0,"maximum":500},"servicer_id":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"}},"required":["id","masked_number","loan_type","principal_cents","accrued_interest_cents","interest_bps","disbursed_on","plan_id","scheduled_payment_cents","next_due_on","status","qualifying_payments","servicer_id","version","updated_at"],"additionalProperties":false},
    "incomeSnapshot":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"annual_income_cents":{"type":"integer","minimum":0,"maximum":1000000000},"family_size":{"type":"integer","minimum":1,"maximum":20},"filing_status":{"enum":["single","married_joint","married_separate","head_of_household"]},"effective_on":{"type":"string","minLength":10,"maxLength":10},"source":{"enum":["fixture","borrower_attested","synthetic_irs"]}},"required":["id","annual_income_cents","family_size","filing_status","effective_on","source"],"additionalProperties":false},
    "estimateResult":{"type":"object","properties":{"plan_id":{"$ref":"#/$defs/id"},"plan_name":{"type":"string"},"eligible":{"type":"boolean"},"ineligible_reasons":{"type":"array","items":{"type":"string"},"maxItems":20},"monthly_payment_cents":{"$ref":"#/$defs/nullableMoney"},"total_projected_payment_cents":{"$ref":"#/$defs/nullableMoney"},"projected_interest_cents":{"$ref":"#/$defs/nullableMoney"},"forgiveness_estimate_cents":{"$ref":"#/$defs/nullableMoney"},"term_months":{"type":"integer","minimum":12,"maximum":360},"projected_end_on":{"$ref":"#/$defs/nullableDate"},"tradeoff":{"type":"string"}},"required":["plan_id","plan_name","eligible","ineligible_reasons","monthly_payment_cents","total_projected_payment_cents","projected_interest_cents","forgiveness_estimate_cents","term_months","projected_end_on","tradeoff"],"additionalProperties":false},
    "estimate":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"loan_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"uniqueItems":true},"selected_plan_id":{"$ref":"#/$defs/id"},"input_snapshot":{"type":"object"},"result":{"$ref":"#/$defs/estimateResult"},"created_at":{"type":"string","format":"date-time"}},"required":["id","loan_ids","selected_plan_id","input_snapshot","result","created_at"],"additionalProperties":false},
    "attestations":{"type":"object","properties":{"information_accurate":{"type":"boolean"},"electronic_signature":{"type":"boolean"}},"required":["information_accurate","electronic_signature"],"additionalProperties":false},
    "application":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"application_type":{"enum":["repayment_plan","annual_recertification"]},"loan_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"uniqueItems":true},"estimate_id":{"$ref":"#/$defs/id"},"selected_plan_id":{"$ref":"#/$defs/id"},"status":{"enum":["draft","submitted","processing","approved","denied","needs_information","withdrawn"]},"attestations":{"$ref":"#/$defs/attestations"},"consent_status":{"enum":["granted","declined","expired"]},"income_snapshot_id":{"$ref":"#/$defs/nullableId"},"document_ids":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true,"maxItems":20},"required_by":{"$ref":"#/$defs/nullableTime"},"requested_action":{"$ref":"#/$defs/nullableText"},"submitted_snapshot":{"anyOf":[{"type":"object"},{"type":"null"}]},"receipt_id":{"$ref":"#/$defs/nullableId"},"version":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","application_type","loan_ids","estimate_id","selected_plan_id","status","attestations","consent_status","income_snapshot_id","document_ids","required_by","requested_action","submitted_snapshot","receipt_id","version","created_at","updated_at"],"additionalProperties":false},
    "document":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"application_id":{"$ref":"#/$defs/id"},"filename":{"type":"string","minLength":1,"maxLength":160},"document_type":{"enum":["pay_stub","tax_return","income_statement","other"]},"tax_period":{"type":"string","minLength":4,"maxLength":20},"checksum_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"submitted_at":{"type":"string","format":"date-time"},"metadata_only":{"const":true}},"required":["id","application_id","filename","document_type","tax_period","checksum_sha256","submitted_at","metadata_only"],"additionalProperties":false},
    "notice":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["application_receipt","application_decision","document_request","payment_status","repayment_status","servicer_transfer","general"]},"loan_id":{"$ref":"#/$defs/nullableId"},"application_id":{"$ref":"#/$defs/nullableId"},"title":{"type":"string","minLength":1,"maxLength":200},"body":{"type":"string","minLength":1,"maxLength":2000},"next_action":{"$ref":"#/$defs/nullableText"},"created_at":{"type":"string","format":"date-time"},"acknowledged_at":{"$ref":"#/$defs/nullableTime"},"version":{"type":"integer","minimum":1},"email_status":{"enum":["disabled","not_prepared","pending","delivered","rejected","unknown"]},"email_request_id":{"$ref":"#/$defs/nullableId"},"email_receipt_id":{"$ref":"#/$defs/nullableId"},"email_message":{"anyOf":[{"$ref":"router-message.schema.json"},{"type":"null"}]},"delivery_attempts":{"type":"integer","minimum":0,"maximum":100},"reconciliation_required":{"type":"boolean"}},"required":["id","kind","loan_id","application_id","title","body","next_action","created_at","acknowledged_at","version","email_status","email_request_id","email_receipt_id","email_message","delivery_attempts","reconciliation_required"],"additionalProperties":false},
    "history":{"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"at":{"type":"string","format":"date-time"},"action":{"type":"string","minLength":1,"maxLength":100},"loan_id":{"$ref":"#/$defs/nullableId"},"application_id":{"$ref":"#/$defs/nullableId"},"servicer_id":{"$ref":"#/$defs/nullableId"},"summary":{"type":"string","minLength":1,"maxLength":500},"event_id":{"$ref":"#/$defs/nullableId"}},"required":["id","at","action","loan_id","application_id","servicer_id","summary","event_id"],"additionalProperties":false}
  }
}
