      ],
      "note": {
        "note_id": "note-grp-osei-care",
        "version": 40,
        "text": "July 20, 2026: Evening: donepezil 10 mg at 20:00. Call Mercy if she skips a dose.",
        "updated_at": "2026-07-20T18:00:00-07:00",
        "updated_by": "person-mercy",
        "history": [
          {
            "version": 1,
            "at": "2025-01-20T18:00:00-08:00",
            "text": "January 20, 2025: Morning tea, then a short walk if she is steady.",
            "person_id": "person-daniel"
          },
          {
            "version": 2,
            "at": "2025-02-03T18:00:00-08:00",
            "text": "February 3, 2025: Add a blood pressure line after breakfast.",
            "person_id": "person-mercy"
          },
          {
            "version": 3,
            "at": "2025-02-17T18:00:00-08:00",
            "text": "February 17, 2025: Soup at lunch on clinic days.",
            "person_id": "person-daniel"
          },
          {
            "version": 4,
            "at": "2025-03-03T18:00:00-08:00",
            "text": "March 3, 2025: Mercy drives on Tuesdays. Daniel covers Thursdays.",
            "person_id": "person-mercy"
          },
          {
            "version": 5,
            "at": "2025-03-17T18:00:00-07:00",
            "text": "March 17, 2025: Keep questions for the doctor on this note.",
            "person_id": "person-daniel"
          },
          {
            "version": 6,
            "at": "2025-03-31T18:00:00-07:00",
            "text": "March 31, 2025: The pharmacy bag goes on the porch, then into the cabinet.",
            "person_id": "person-mercy"
          },
          {
            "version": 7,
            "at": "2025-04-14T18:00:00-07:00",
            "text": "April 14, 2025: Weekday aide arrives after school and leaves before dinner.",
            "person_id": "person-daniel"
          },
          {
            "version": 8,
            "at": "2025-04-28T18:00:00-07:00",
            "text": "April 28, 2025: Weekend cover is Brightpath. The schedule is the only share.",
            "person_id": "person-mercy"
          },
          {
            "version": 9,
            "at": "2025-05-12T18:00:00-07:00",
            "text": "May 12, 2025: Skip the loud evening program.",
            "person_id": "person-daniel"
          },
          {
            "version": 10,
            "at": "2025-05-26T18:00:00-07:00",
            "text": "May 26, 2025: Honey in the tea. No extra sugar in the oatmeal.",
            "person_id": "person-mercy"
          },
          {
            "version": 11,
            "at": "2025-06-09T18:00:00-07:00",
            "text": "June 9, 2025: The blue sweater is on the chair for cool mornings.",
            "person_id": "person-daniel"
          },
          {
            "version": 12,
            "at": "2025-06-23T18:00:00-07:00",
            "text": "June 23, 2025: Call Mercy if breakfast is refused.",
            "person_id": "person-mercy"
          },
          {
            "version": 13,
            "at": "2025-07-07T18:00:00-07:00",
            "text": "July 7, 2025: The garden walk replaces the block walk in warm weather.",
            "person_id": "person-daniel"
          },
          {
            "version": 14,
            "at": "2025-07-21T18:00:00-07:00",
            "text": "July 21, 2025: Clinic card stays by the phone.",
            "person_id": "person-mercy"
          },
          {
            "version": 15,
            "at": "2025-08-04T18:00:00-07:00",
            "text": "August 4, 2025: Write the refill date when the pharmacy calls.",
            "person_id": "person-daniel"
          },
          {
            "version": 16,
            "at": "2025-08-18T18:00:00-07:00",
            "text": "August 18, 2025: Ama checks the fridge list on Sundays.",
            "person_id": "person-mercy"
          },
          {
            "version": 17,
            "at": "2025-09-01T18:00:00-07:00",
            "text": "September 1, 2025: Kofi reads one chapter after the news.",
            "person_id": "person-daniel"
          },
          {
            "version": 18,
            "at": "2025-09-15T18:00:00-07:00",
            "text": "September 15, 2025: Yaa sits the afternoon if Mercy is at work.",
            "person_id": "person-mercy"
          },
          {
            "version": 19,
            "at": "2025-09-29T18:00:00-07:00",
            "text": "September 29, 2025: The hallway light stays on after dusk.",
            "person_id": "person-daniel"
          },
          {
            "version": 20,
            "at": "2025-10-13T18:00:00-07:00",
            "text": "October 13, 2025: Confirm the evening dose was seen, without copying the vault.",
            "person_id": "person-mercy"
          },
          {
            "version": 21,
            "at": "2025-10-27T18:00:00-07:00",
            "text": "October 27, 2025: Blood pressure log moves to the notebook in the drawer.",
            "person_id": "person-daniel"
          },
          {
            "version": 22,
            "at": "2025-11-10T18:00:00-08:00",
            "text": "November 10, 2025: The neighbor may bring fruit. No medication from neighbors.",
            "person_id": "person-mercy"
          },
          {
            "version": 23,
            "at": "2025-11-24T18:00:00-08:00",
            "text": "November 24, 2025: Short nap after lunch on hot days.",
            "person_id": "person-daniel"
          },
          {
            "version": 24,
            "at": "2025-12-08T18:00:00-08:00",
            "text": "December 8, 2025: The bus time for Ama is on the fridge, separate from this note.",
            "person_id": "person-mercy"
          },
          {
            "version": 25,
            "at": "2025-12-22T18:00:00-08:00",
            "text": "December 22, 2025: If she asks for Daniel while he is traveling, Mercy answers.",
            "person_id": "person-daniel"
          },
          {
            "version": 26,
            "at": "2026-01-05T18:00:00-08:00",
            "text": "January 5, 2026: The weekday aide is Rosa Delgado. She gets the schedule and the med list.",
            "person_id": "person-mercy"
          },
          {
            "version": 27,
            "at": "2026-01-19T18:00:00-08:00",
            "text": "January 19, 2026: Keep the evening routine at the same hour through the summer.",
            "person_id": "person-daniel"
          },
          {
            "version": 28,
            "at": "2026-02-02T18:00:00-08:00",
            "text": "February 2, 2026: The clinic asked for the walking notes.",
            "person_id": "person-mercy"
          },
          {
            "version": 29,
            "at": "2026-02-16T18:00:00-08:00",
            "text": "February 16, 2026: Add a glass of water with the evening dose.",
            "person_id": "person-daniel"
          },
          {
            "version": 30,
            "at": "2026-03-02T18:00:00-08:00",
            "text": "March 2, 2026: Mercy reviews the cabinet before the weekend.",
            "person_id": "person-mercy"
          },
          {
            "version": 31,
            "at": "2026-03-16T18:00:00-07:00",
            "text": "March 16, 2026: The weekend aide handle stays brightpath-weekend.",
            "person_id": "person-daniel"
          },
          {
            "version": 32,
            "at": "2026-03-30T18:00:00-07:00",
            "text": "March 30, 2026: Travel week: Mercy is the contact on the note.",
            "person_id": "person-mercy"
          },
          {
            "version": 33,
            "at": "2026-04-13T18:00:00-07:00",
            "text": "April 13, 2026: Write missed doses in the checklist, then tell Mercy.",
            "person_id": "person-daniel"
          },
          {
            "version": 34,
            "at": "2026-04-27T18:00:00-07:00",
            "text": "April 27, 2026: The clinic wants the blood pressure notebook at the next visit.",
            "person_id": "person-mercy"
          },
          {
            "version": 35,
            "at": "2026-05-11T18:00:00-07:00",
            "text": "May 11, 2026: Keep the porch light on when an aide is expected.",
            "person_id": "person-daniel"
          },
          {
            "version": 36,
            "at": "2026-05-25T18:00:00-07:00",
            "text": "May 25, 2026: No vault number belongs on this note.",
            "person_id": "person-mercy"
          },
          {
            "version": 37,
            "at": "2026-06-08T18:00:00-07:00",
            "text": "June 8, 2026: Rosa covers weekdays. Brightpath covers the weekend block.",
            "person_id": "person-daniel"
          },
          {
            "version": 38,
            "at": "2026-06-22T18:00:00-07:00",
            "text": "June 22, 2026: Daniel is offline the afternoon he flies. Mercy takes calls.",
            "person_id": "person-mercy"
          },
          {
            "version": 39,
            "at": "2026-07-06T18:00:00-07:00",
            "text": "July 6, 2026: Pharmacy auto-refill is on the calendar. No extra order.",
            "person_id": "person-daniel"
          },
          {
            "version": 40,
            "at": "2026-07-20T18:00:00-07:00",
            "text": "July 20, 2026: Evening: donepezil 10 mg at 20:00. Call Mercy if she skips a dose.",
            "person_id": "person-mercy"
          }
        ]
      },
