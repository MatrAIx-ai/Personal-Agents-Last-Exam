        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "platewright.plan.changed",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "platewright.guest.changed",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "platewright.pantry.changed",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "platewright.shopping.changed",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": null,
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [
      "application/json"
    ],
    "implemented_storage_adapters": [
      "storage.file",
      "storage.inline"
    ],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
