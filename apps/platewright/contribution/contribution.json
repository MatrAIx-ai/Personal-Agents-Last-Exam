        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
