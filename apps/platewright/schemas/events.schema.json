{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platewright incoming events",
  "description": "Core envelope (event_id, at with a UTC offset, operation, payload) for the six events. Generated by scripts/build-contracts.cjs.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "platewright.member.updated"
        },
        "payload": {
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "action": {
              "const": "set"
            },
            "constraint": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "kind": {
                  "enum": [
                    "allergy",
                    "medical",
                    "diet",
                    "limit",
                    "dislike"
                  ]
                },
                "allergen": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "strict": {
                  "type": "boolean"
                },
                "ingredient_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "flag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "diet": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "nutrient": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "max": {
                  "type": "number"
                },
                "effective_from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expires_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "kind",
                "note"
              ],
              "additionalProperties": false
            },
            "by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "member_id",
            "action",
            "constraint"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
