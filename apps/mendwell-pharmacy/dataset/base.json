  "drugs": [
    {
      "drug_id": "d-atorvastatin-40",
      "generic_name": "atorvastatin calcium",
      "strength": "40 mg",
      "form": "film-coated tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Keep the tablets at controlled room temperature, about 20 to 25 degrees C (68 to 77 degrees F).",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "4e06b20d-cc5d-46eb-991b-5972248de3af",
            "version": 14,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=4e06b20d-cc5d-46eb-991b-5972248de3af",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "The tablets are taken by mouth once a day, at any time of day, and can be taken with or without food.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "4e06b20d-cc5d-46eb-991b-5972248de3af",
            "version": 14,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=4e06b20d-cc5d-46eb-991b-5972248de3af",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-donepezil-5",
      "generic_name": "donepezil hydrochloride",
      "strength": "5 mg",
      "form": "film-coated tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Store at controlled room temperature, 20 to 25 degrees C (68 to 77 degrees F).",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "76bf638e-dbde-418e-8977-1caf009990bc",
            "version": 16,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=76bf638e-dbde-418e-8977-1caf009990bc",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "Tablets are taken in the evening just before bedtime, and food does not matter.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "76bf638e-dbde-418e-8977-1caf009990bc",
            "version": 16,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=76bf638e-dbde-418e-8977-1caf009990bc",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-warfarin-5",
      "generic_name": "warfarin sodium",
      "strength": "5 mg",
      "form": "tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Keep at 20 to 25 degrees C (68 to 77 degrees F), shielded from light and moisture, in a tight light-resistant container.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "8ad881e0-ca41-42ad-9d7d-eb85b3a30af0",
            "version": 15,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8ad881e0-ca41-42ad-9d7d-eb85b3a30af0",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "Patients are counseled to eat a balanced diet with a steady vitamin K intake and avoid big swings, such as large servings of leafy greens.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "8ad881e0-ca41-42ad-9d7d-eb85b3a30af0",
            "version": 15,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8ad881e0-ca41-42ad-9d7d-eb85b3a30af0",
            "section": "17 PATIENT COUNSELING INFORMATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-lisinopril-10",
      "generic_name": "lisinopril",
      "strength": "10 mg",
      "form": "tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Keep at room temperature, 20 to 25 degrees C (68 to 77 degrees F), away from damp, frost and high heat.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "0e6364a4-6d66-4151-8197-d45e2a762895",
            "version": 27,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=0e6364a4-6d66-4151-8197-d45e2a762895",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "For high blood pressure in adults the usual range is 20 to 40 mg a day, taken as one dose each day.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "0e6364a4-6d66-4151-8197-d45e2a762895",
            "version": 27,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=0e6364a4-6d66-4151-8197-d45e2a762895",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-levothyroxine-50",
      "generic_name": "levothyroxine sodium",
      "strength": "50 mcg",
      "form": "tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Store at 20 to 25 degrees C (68 to 77 degrees F), protected from light and moisture.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "4ddcaec1-a58f-340b-9bc1-bbe048b8c885",
            "version": 10,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=4ddcaec1-a58f-340b-9bc1-bbe048b8c885",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "The label calls for one daily dose on an empty stomach, about 30 to 60 minutes before breakfast.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "4ddcaec1-a58f-340b-9bc1-bbe048b8c885",
            "version": 10,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=4ddcaec1-a58f-340b-9bc1-bbe048b8c885",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-sertraline-50",
      "generic_name": "sertraline hydrochloride",
      "strength": "50 mg",
      "form": "film-coated tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Store at 20 to 25 degrees C (68 to 77 degrees F), with brief excursions to 15 to 30 degrees C allowed.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "42120ff8-b353-4632-9ea9-54de9a698724",
            "version": 28,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=42120ff8-b353-4632-9ea9-54de9a698724",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "When therapy ends, the label advises lowering the amount gradually rather than stopping abruptly, where possible.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "42120ff8-b353-4632-9ea9-54de9a698724",
            "version": 28,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=42120ff8-b353-4632-9ea9-54de9a698724",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-omeprazole-20",
      "generic_name": "omeprazole",
      "strength": "20 mg",
      "form": "delayed-release capsule",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Keep in a tight container at 20 to 25 degrees C (68 to 77 degrees F), protected from light and moisture.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "c5af5f4b-17be-7245-b281-f27c87831242",
            "version": 7,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=c5af5f4b-17be-7245-b281-f27c87831242",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "The capsules are swallowed whole, not chewed; for someone who cannot swallow one, it can be opened and all of its pellets emptied onto a tablespoon of soft applesauce that is not hot, then swallowed at once with cool water.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "c5af5f4b-17be-7245-b281-f27c87831242",
            "version": 7,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=c5af5f4b-17be-7245-b281-f27c87831242",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-metformin-500",
      "generic_name": "metformin hydrochloride",
      "strength": "500 mg",
      "form": "tablet",
      "quantities": [
        60,
        180
      ],
      "facts": [
        {
          "text": "Keep at 20 to 25 degrees C (68 to 77 degrees F), with short spells from 15 to 30 degrees C allowed; it is handed out in a tightly closing, light-shielding bottle with a child-resistant cap.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "2387a618-24d8-4813-aa83-9114edb35374",
            "version": 7,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=2387a618-24d8-4813-aa83-9114edb35374",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "The tablets are meant to be taken with meals.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "2387a618-24d8-4813-aa83-9114edb35374",
            "version": 7,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=2387a618-24d8-4813-aa83-9114edb35374",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-amlodipine-5",
      "generic_name": "amlodipine besylate",
      "strength": "5 mg",
      "form": "tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Store at 20 to 25 degrees C (68 to 77 degrees F) in tight, light-resistant containers.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "003dd1ec-16f8-4f96-b6a8-c4689d35892a",
            "version": 29,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=003dd1ec-16f8-4f96-b6a8-c4689d35892a",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "The tablets are taken by mouth once a day, with 1 to 2 weeks suggested between dose adjustments.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "003dd1ec-16f8-4f96-b6a8-c4689d35892a",
            "version": 29,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=003dd1ec-16f8-4f96-b6a8-c4689d35892a",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-albuterol-90",
      "generic_name": "albuterol sulfate",
      "strength": "108 mcg (90 mcg base) per actuation",
      "form": "metered-dose inhaler",
      "quantities": [
        1,
        2
      ],
      "facts": [
        {
          "text": "Store between 15 and 25 degrees C (59 and 77 degrees F); protect from freezing and prolonged direct sunlight.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "7bb5b6dd-9105-4ee7-b205-ed79cf4b371b",
            "version": 16,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=7bb5b6dd-9105-4ee7-b205-ed79cf4b371b",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "Shake the inhaler well before each spray, and prime it with three sprays into the air if new or unused for over two weeks.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "7bb5b6dd-9105-4ee7-b205-ed79cf4b371b",
            "version": 16,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=7bb5b6dd-9105-4ee7-b205-ed79cf4b371b",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    },
    {
      "drug_id": "d-amoxicillin-250-5",
      "generic_name": "amoxicillin",
      "strength": "250 mg/5 mL",
      "form": "powder for oral suspension",
      "quantities": [
        100,
        150
      ],
      "facts": [
        {
          "text": "Keep the unmixed powder at controlled room temperature, 20 to 25 degrees C (68 to 77 degrees F).",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "9ce26893-c7a1-47e9-98f9-f5d998cac418",
            "version": 2,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=9ce26893-c7a1-47e9-98f9-f5d998cac418",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "Once mixed, the liquid is shaken well every time before it is used, the bottle is kept tightly closed, and whatever is left after 14 days is thrown away.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "9ce26893-c7a1-47e9-98f9-f5d998cac418",
            "version": 2,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=9ce26893-c7a1-47e9-98f9-f5d998cac418",
            "section": "2.6 Directions for Mixing Oral Suspension"
          }
        }
      ]
    },
    {
      "drug_id": "d-montelukast-4",
      "generic_name": "montelukast sodium",
      "strength": "4 mg",
      "form": "chewable tablet",
      "quantities": [
        30,
        90
      ],
      "facts": [
        {
          "text": "Store at 20 to 25 degrees C (68 to 77 degrees F), protected from moisture and light, in the original package.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "ba42b0a9-83f1-4283-a853-f99cdd0761b9",
            "version": 22,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=ba42b0a9-83f1-4283-a853-f99cdd0761b9",
            "section": "16 HOW SUPPLIED/STORAGE AND HANDLING"
          }
        },
        {
          "text": "For asthma the label has the tablet taken once a day in the evening, with or without food.",
          "source": {
            "publisher": "DailyMed, U.S. National Library of Medicine",
            "set_id": "ba42b0a9-83f1-4283-a853-f99cdd0761b9",
            "version": 22,
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=ba42b0a9-83f1-4283-a853-f99cdd0761b9",
            "section": "2 DOSAGE AND ADMINISTRATION"
          }
        }
      ]
    }
