              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
            },
            "prescriber_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
            },
            "drug_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "fills_authorized": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "written_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "required": [
            "rx_id",
            "patient_id",
            "prescriber_id",
            "drug_id",
            "quantity",
            "fills_authorized",
            "written_on"
          ],
          "additionalProperties": false
