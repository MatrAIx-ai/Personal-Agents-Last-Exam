  {
    "name": "personal-records.upload_document",
    "description": "Upload a digital document (PDF, PNG, JPEG, TXT, or raw attachment). Enforces SHA-256 deduplication and initiates version 1.",
    "read_only": false,
    "scope": "personal-records.upload_document",
    "resource_target": "document",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "content_bytes": { "type": "string", "minLength": 1 },
        "mime_type": {
          "type": "string",
          "enum": ["application/pdf", "image/png", "image/jpeg", "text/plain", "application/octet-stream"]
        },
        "category": {
          "type": "string",
          "enum": ["tax", "employment", "insurance", "property", "utilities", "healthcare", "banking", "legal", "other"]
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "valid_until": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "raw_text_override": { "type": "string" },
        "expected_version": {
          "type": "object",
          "properties": {
            "epoch": { "type": "integer", "minimum": 1 },
            "revision": { "type": "integer", "minimum": 0 }
          },
          "required": ["epoch", "revision"],
          "additionalProperties": false
        },
        "request_id": { "type": "string", "minLength": 1 }
      },
      "required": ["title", "content_bytes", "mime_type", "expected_version", "request_id"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": { "const": "committed" },
        "app_id": { "const": "personal-records" },
        "version": {
          "type": "object",
          "properties": {
            "epoch": { "type": "integer", "minimum": 1 },
            "revision": { "type": "integer", "minimum": 0 }
          },
          "required": ["epoch", "revision"],
          "additionalProperties": false
        },
        "document_id": { "type": "string" },
        "version_number": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string" },
        "processing_status": { "type": "string" }
      },
      "required": ["status", "app_id", "version", "document_id", "version_number", "sha256", "processing_status"],
      "additionalProperties": false
    }
  },
