[
  {
    "name": "personal-records.search",
    "description": "Full-text and metadata search across document titles, tags, categories, and extracted text. Non-mutating.",
    "read_only": true,
    "scope": "personal-records.search",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "minLength": 0, "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["tax", "employment", "insurance", "property", "utilities", "healthcare", "banking", "legal", "other"]
        },
        "verification_state": {
          "type": "string",
          "enum": ["INFERRED", "USER_CONFIRMED", "SUPERSEDED"]
        },
        "valid_before": { "type": "string", "format": "date-time" },
        "valid_after": { "type": "string", "format": "date-time" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "offset": { "type": "integer", "minimum": 0 }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": { "const": "ok" },
        "app_id": { "const": "personal-records" },
        "version": {
          "type": "object",
          "properties": {
            "epoch": { "type": "integer", "minimum": 1 },
            "revision": { "type": "integer", "minimum": 0 }
          },
          "required": ["epoch", "revision"],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": { "type": "object" }
        },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["status", "app_id", "version", "items", "total"],
      "additionalProperties": false
    }
  },
