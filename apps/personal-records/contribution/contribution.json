{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "personal-records",
  "app_categories": [
    "personal"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        { "name": "personal-records.search", "effect": "read", "caller": "agent" },
        { "name": "personal-records.get_document", "effect": "read", "caller": "agent" },
        { "name": "personal-records.list_proposals", "effect": "read", "caller": "agent" },
        { "name": "personal-records.list_links", "effect": "read", "caller": "agent" },
        { "name": "personal-records.upload_document", "effect": "write", "caller": "agent" },
        { "name": "personal-records.import_from_source", "effect": "write", "caller": "agent" },
        { "name": "personal-records.create_version", "effect": "write", "caller": "agent" },
        { "name": "personal-records.link_documents", "effect": "write", "caller": "agent" },
        { "name": "personal-records.create_evidence_claim", "effect": "write", "caller": "agent" },
        { "name": "personal-records.propose_update", "effect": "write", "caller": "agent" },
        { "name": "personal-records.confirm_update", "effect": "write", "caller": "agent" },
        { "name": "personal-records.check_expiries", "effect": "write", "caller": "agent" },
        { "name": "personal-records.check_discrepancies", "effect": "write", "caller": "agent" }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        { "name": "env.reset", "effect": "admin", "caller": "infra" },
        { "name": "env.load_seed", "effect": "admin", "caller": "infra" },
        { "name": "env.apply_event", "effect": "admin", "caller": "infra" },
        { "name": "env.snapshot", "effect": "admin", "caller": "infra" },
        { "name": "env.event_status", "effect": "admin", "caller": "infra" },
        { "name": "env.validate_bundle", "effect": "admin", "caller": "infra" }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "Per-App lock and optimistic epoch/revision check",
    "commit_confirmation": "committed + epoch/revision; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "personal-records.upsert",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "personal-records.inject_document",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "personal-records.expiry_check",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "personal-records.confirm_decision",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": "gui.json",
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [
      "image/png",
      "image/jpeg",
      "application/json",
      "application/pdf",
      "text/plain"
    ],
    "implemented_storage_adapters": [
      "storage.file",
      "storage.inline"
    ],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
