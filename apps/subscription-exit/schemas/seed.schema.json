{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid_active",
        "cancellation_scheduled",
        "free"
      ]
    },
    "period_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "period_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "next_period_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "decision_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "saved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "saved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "id",
          "title",
          "saved_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 18,
      "minItems": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "subscription_started",
              "period_started",
              "cancellation_scheduled",
              "cancellation_revoked",
              "paid_access_ended",
              "plan_reviewed"
            ]
          }
        },
        "required": [
          "id",
          "at",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 96,
      "minItems": 0
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "cancel",
              "revoke"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "abandoned",
              "confirmed"
            ]
          },
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "decision_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "id",
          "action",
          "status",
          "phase",
          "decision_revision",
          "created_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 128,
      "minItems": 0
    },
    "action_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "preview_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "cancel",
              "revoke"
            ]
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "resulting_status": {
            "type": "string",
            "enum": [
              "paid_active",
              "cancellation_scheduled",
              "free"
            ]
          },
          "effective_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "id",
          "preview_id",
          "action",
          "confirmed_at",
          "resulting_status",
          "effective_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 128,
      "minItems": 0
    }
  },
  "required": [
    "account_id",
    "status",
    "period_start",
    "period_end",
    "next_period_end",
    "phase",
    "decision_revision",
    "ended_at",
    "saved",
    "history",
    "previews",
    "action_receipts"
  ],
  "additionalProperties": false
}
