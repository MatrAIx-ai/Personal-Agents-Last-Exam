              "action": {
                "type": "string",
                "enum": [
                  "cancel",
                  "revoke"
                ]
              },
              "confirmed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "resulting_status": {
                "type": "string",
                "enum": [
                  "paid_active",
                  "cancellation_scheduled",
                  "free"
                ]
              },
              "effective_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": [
              "id",
              "preview_id",
              "action",
              "confirmed_at",
              "resulting_status",
              "effective_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 128,
          "minItems": 0
        }
      },
      "required": [
        "account_id",
        "status",
        "period_start",
        "period_end",
        "next_period_end",
        "phase",
        "decision_revision",
        "ended_at",
        "saved",
        "history",
        "previews",
        "action_receipts"
