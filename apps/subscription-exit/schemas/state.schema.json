              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "saved_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": [
              "id",
              "title",
              "saved_at"
            ],
            "additionalProperties": false
