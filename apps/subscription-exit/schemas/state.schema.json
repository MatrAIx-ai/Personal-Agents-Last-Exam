            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "cancel",
                  "revoke"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "abandoned",
                  "confirmed"
                ]
              },
              "phase": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "decision_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
