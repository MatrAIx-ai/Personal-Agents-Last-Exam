              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "subscription_started",
                  "period_started",
                  "cancellation_scheduled",
                  "cancellation_revoked",
                  "paid_access_ended",
                  "plan_reviewed"
                ]
              }
            },
            "required": [
              "id",
              "at",
              "kind"
            ],
            "additionalProperties": false
          },
          "maxItems": 96,
          "minItems": 0
