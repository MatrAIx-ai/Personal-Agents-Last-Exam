{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pale.app-state.v1"
    },
    "schema_version": {
      "const": 1
    },
    "package_version": {
      "const": "0.1.0"
    },
    "core_api_version": {
      "const": "1.2.0"
    },
    "app_id": {
      "const": "subscription-exit"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[-a-zA-Z0-9_]{1,80}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "type": "string"
    },
    "next_id": {
      "type": "integer",
      "minimum": 1
    },
    "virtual_now": {
      "type": "string",
      "format": "date-time"
    },
    "binding": {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "person_id"
            ],
            "additionalProperties": false
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string"
              },
              "account_id": {
                "type": "string"
              },
              "owner_person_id": {
                "type": "string"
              }
            },
            "required": [
              "app_id",
              "account_id",
              "owner_person_id"
            ],
            "additionalProperties": false
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "people",
        "accounts",
        "objects"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "allow",
          "constraints"
        ],
        "additionalProperties": false
      }
    },
    "initial_data": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "paid_active",
            "cancellation_scheduled",
            "free"
          ]
        },
        "period_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "period_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
