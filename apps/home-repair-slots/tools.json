[
  {
    "name": "home-repair-slots.list_slots",
    "description": "Read future available slot estimates within the supplied scenario limits.",
    "read_only": true,
    "scope": "home-repair-slots.list_slots",
    "resource_target": "bound synthetic customer account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "home-repair-slots"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "provider_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "estimate_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99999999
              }
            },
            "required": [
              "id",
              "provider_id",
              "start",
              "end",
              "estimate_minor"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "constraints": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "through_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "timezone": {
              "enum": [
                "Asia/Shanghai"
              ]
            },
            "currency": {
              "enum": [
                "CNY"
              ]
            },
            "budget_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999999
            }
          },
          "required": [
            "from_date",
            "through_date",
            "timezone",
            "currency",
            "budget_minor"
          ],
          "additionalProperties": false
        },
        "service": {
          "enum": [
            "Cabinet-hinge adjustment"
          ]
        },
        "reservation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "booking_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "slots",
        "providers",
        "constraints",
        "service",
        "reservation_id",
        "booking_ids"
      ],
      "additionalProperties": false
    }
  },
