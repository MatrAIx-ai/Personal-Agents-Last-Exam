{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
    },
    "service": {
      "enum": [
        "Cabinet-hinge adjustment"
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "from_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "through_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timezone": {
          "enum": [
            "Asia/Shanghai"
          ]
        },
        "currency": {
          "enum": [
            "CNY"
          ]
        },
        "budget_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "required": [
        "from_date",
        "through_date",
        "timezone",
        "currency",
        "budget_minor"
      ],
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "provider_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "estimate_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999999
          },
          "taken": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider_id",
          "start",
          "end",
          "estimate_minor",
          "taken"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "status": {
            "enum": [
              "open",
              "invalidated",
              "discarded",
              "confirmed"
            ]
          }
        },
        "required": [
          "id",
          "slot_id",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "status": {
            "enum": [
              "confirmed",
              "cancelled"
            ]
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          }
        },
        "required": [
          "id",
          "slot_id",
          "status",
          "origin"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "select_slot",
              "confirm_reservation",
              "discard_reservation",
              "reschedule_booking",
              "cancel_booking",
              "slot_taken"
            ]
          },
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "prior_slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          }
        },
        "required": [
          "operation",
          "object_id",
          "slot_id",
          "at"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    }
  },
  "required": [
    "account_id",
    "service",
    "constraints",
    "providers",
    "slots",
    "reservations",
    "bookings",
    "history"
  ],
  "additionalProperties": false
}
