{
  "schema_version": 1,
  "app_id": "stoopside",
  "version": "0.1.0",
  "core_api_version": "1.2.0",
  "maintainer": {
    "contact": "Rohan Pandey (@Rohan-Pandey1729), Stoopside environment proposal"
  },
  "license": "MIT",
  "entrypoint": "plugin.cjs",
  "service": "service.cjs",
  "tools": "tools.json",
  "schemas": {
    "seed": "schemas/seed.schema.json",
    "state": "schemas/state.schema.json",
    "events": "schemas/events.schema.json"
  },
  "fixtures": {
    "seed": "fixtures/minimal.json",
    "binding": "fixtures/binding.json",
    "policies": "fixtures/policies.json"
  },
  "dependencies": [],
  "event_types": [
    "stoopside.member.joined",
    "stoopside.member.removed",
    "stoopside.membership.decided",
    "stoopside.rsvp.changed_by_other",
    "stoopside.event.changed_by_cohost",
    "stoopside.signup.claimed_by_other",
    "stoopside.signup.released_by_other",
    "stoopside.swap.proposed_by_other",
    "stoopside.swap.answered",
    "stoopside.post.created_by_other"
  ],
  "capabilities": {
    "modes": [
      "synthetic"
    ],
    "resources": true,
    "ui": "pale.web business pages (gui/), served by runtime/web/server.cjs",
    "real_delivery": false
  },
  "limitations": [
    "Pages are served by the shared business Web Host over the Agent MCP connection; they hold no business state.",
    "Groups use a fixed UTC offset with no daylight-saving changes.",
    "Only fixtures/minimal.json is the manifest seed; the Riverside and Hillcrest fixtures load with env.load_seed and their own binding.",
    "Notices are stored as Mail channel.email messages; examples/publish-to-mail.cjs publishes them through Messaging."
  ],
  "dataset": "contribution/dataset.json",
  "resources": {
    "catalog": "contribution/assets.catalog.json",
    "directory": "assets"
  },
  "contribution": "contribution/contribution.json"
}
