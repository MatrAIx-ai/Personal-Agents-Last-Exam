                "minLength": 1,
                "maxLength": 20
              },
              "surname": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "given_names": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "date_of_birth": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
