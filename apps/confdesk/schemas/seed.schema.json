          "at",
          "via",
          "letter_id",
          "fields",
          "business_days",
          "counted_from",
          "expected_on",
          "status",
          "issued_letter_id",
          "issued_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "enum": [
              "registration_confirmed",
              "letter_issued",
              "correction_issued",
              "paper_removed"
            ]
