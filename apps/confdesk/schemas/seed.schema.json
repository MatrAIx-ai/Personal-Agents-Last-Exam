{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:confdesk:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "mail_account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "short_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "starts_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date YYYY-MM-DD."
        },
        "ends_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date YYYY-MM-DD."
        },
        "registration_prefix": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$",
          "description": "Registration IDs are <prefix>-R-<number, 4 digits>."
        },
        "registration_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999,
          "description": "Number the desk assigns to this account's registration."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code."
        },
        "author_rates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time",
                "description": "The rate applies to registrations from this instant until the next row."
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              }
            },
            "required": [
              "from",
              "amount_cents"
            ],
            "additionalProperties": false
          },
          "maxItems": 10,
          "minItems": 1,
          "description": "Author rate schedule in from order; the first row starts at or before opens_at."
        },
        "rate_covers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20,
          "minItems": 1
        },
        "preview_ttl_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "letter_business_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "The invitation letter is issued this many business days after the registration date."
        },
        "correction_business_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "A corrected letter is issued this many business days after the correction request date."
        },
        "letter_signatory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "window": {
          "type": "object",
          "properties": {
            "opens_at": {
              "type": "string",
              "format": "date-time"
            },
            "closes_at": {
              "type": "string",
              "format": "date-time",
              "description": "Last instant at which an author registration is accepted; the program deadline."
            },
            "opened_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When Infra applied confdesk.registration.open."
            },
            "closed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When Infra applied confdesk.deadline.passed."
            }
          },
          "required": [
            "opens_at",
            "closes_at",
            "opened_at",
            "closed_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "short_name",
        "name",
        "venue",
        "city",
        "country",
        "starts_on",
        "ends_on",
        "registration_prefix",
        "registration_number",
        "currency",
        "author_rates",
        "rate_covers",
        "preview_ttl_minutes",
        "letter_business_days",
        "correction_business_days",
        "letter_signatory",
        "window"
      ],
      "additionalProperties": false
    },
    "business_calendar": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone in which business dates are counted."
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Calendar date YYYY-MM-DD."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "date",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 400,
          "description": "Dates that are not business days, besides Saturdays and Sundays."
        }
      },
      "required": [
        "timezone",
        "holidays"
      ],
      "additionalProperties": false,
      "description": "Optional. Without it the desk uses its default calendar (America/Chicago, US federal holidays 2026-2028); holidays [] means no holidays."
    },
    "attendee": {
      "type": "object",
      "properties": {
        "details": {
          "type": "object",
          "properties": {
            "salutation": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                {
                  "type": "null"
                }
              ]
            },
            "surname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "given_names": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "date_of_birth": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Calendar date YYYY-MM-DD."
            },
            "nationality": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "salutation",
            "surname",
            "given_names",
            "date_of_birth",
            "nationality"
          ],
          "additionalProperties": false
        },
        "affiliation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "at",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "details",
        "affiliation",
        "created_at",
        "updated_at",
        "history"
      ],
      "additionalProperties": false
    },
    "paper": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 30,
          "minItems": 1
        },
        "session": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "awaiting_registration",
            "in_program",
            "removed"
          ]
        },
        "registration_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "at",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "authors",
        "session",
        "submitted_at",
        "accepted_at",
        "status",
        "registration_id",
        "removed_at",
        "created_at",
        "updated_at",
        "history"
      ],
      "additionalProperties": false
    },
    "registration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "type": {
              "const": "author"
            },
            "status": {
              "const": "completed"
            },
            "paper_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "preview_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "previewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            },
            "rate": {
              "type": "object",
              "properties": {
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000000
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "description": "ISO 4217 currency code."
                }
              },
              "required": [
                "amount_cents",
                "currency"
              ],
              "additionalProperties": false
            },
            "covers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            },
            "payment_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Opaque payment label, one of the account's payment_labels."
            },
            "payment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "at",
                  "action"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            }
          },
          "required": [
            "id",
            "type",
            "status",
            "paper_id",
            "preview_id",
            "previewed_at",
            "completed_at",
            "rate",
            "covers",
            "payment_label",
            "payment_id",
            "created_at",
            "updated_at",
            "history"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "payment_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Opaque payment label, one of the account's payment_labels."
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque payment label, one of the account's payment_labels."
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "registration_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          }
        },
        "required": [
          "id",
          "at",
          "label",
          "amount_cents",
          "currency",
          "description",
          "registration_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "letters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
