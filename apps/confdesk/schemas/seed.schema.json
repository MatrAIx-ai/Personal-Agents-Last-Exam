            ]
          },
          "name_on_letter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170,
            "description": "SURNAME Given names, as printed."
          },
          "details": {
            "type": "object",
            "properties": {
              "salutation": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "surname": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "given_names": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "date_of_birth": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Calendar date YYYY-MM-DD."
              },
              "nationality": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "salutation",
              "surname",
              "given_names",
              "date_of_birth",
              "nationality"
            ],
            "additionalProperties": false
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "business_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "counted_from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD in the business calendar's time zone."
          },
          "due_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD in the business calendar's time zone."
          },
          "status": {
            "enum": [
              "current",
              "superseded"
            ]
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "registration_id",
          "kind",
          "correction_id",
          "name_on_letter",
          "details",
          "issued_at",
          "business_days",
          "counted_from",
          "due_on",
          "status",
          "superseded_by",
          "text",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "correction_requests": {
      "type": "array",
