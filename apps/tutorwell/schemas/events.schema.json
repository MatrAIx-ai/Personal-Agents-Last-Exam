{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:tutorwell:events:1",
  "description": "Scenario events applied by Infra with env.apply_event at event.at.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "tutorwell.slot.released"
        },
        "payload": {
          "type": "object",
          "properties": {
            "slot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "tutor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "minutes": {
              "type": "integer",
              "minimum": 15,
              "maximum": 240
            },
            "mode": {
              "enum": [
                "in_person",
                "online"
              ]
            }
          },
          "required": [
            "slot_id",
            "tutor_id",
            "start",
            "minutes",
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "tutorwell.slot.withdrawn"
        },
        "payload": {
          "type": "object",
          "properties": {
            "slot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "slot_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "tutorwell.appointment.attended"
        },
        "payload": {
          "type": "object",
          "properties": {
            "appointment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "outcome": {
              "enum": [
                "completed",
                "no_show"
              ]
            }
          },
          "required": [
            "appointment_id",
            "outcome"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "tutorwell.report.posted"
        },
        "payload": {
          "type": "object",
          "properties": {
            "appointment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "covered_skill_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "maxItems": 20,
              "uniqueItems": true,
              "minItems": 1
            },
            "followups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "followup_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "kind": {
                    "enum": [
                      "practice",
                      "revise",
                      "read",
                      "prepare"
                    ]
                  },
                  "item_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "maxItems": 20,
                    "uniqueItems": true
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 600
                  },
                  "due_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "followup_id",
                  "kind",
                  "item_refs",
                  "minutes"
                ],
                "additionalProperties": false
              },
              "maxItems": 20
            },
            "next_focus": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "appointment_id",
            "covered_skill_ids",
            "followups"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "tutorwell.rules.changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "setting": {
              "enum": [
                "weekly_cap",
                "cancel_cutoff_hours",
                "no_show_limit",
                "no_show_window_days",
                "suspension_days"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            }
          },
          "required": [
            "setting",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
