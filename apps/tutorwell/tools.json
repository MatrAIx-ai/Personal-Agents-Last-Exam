              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "requires_draft": {
                "type": "boolean"
              },
              "skills": {
                "type": "array",
