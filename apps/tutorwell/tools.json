[
  {
    "name": "tutorwell.services.list",
    "description": "The centre's services (math tutoring, writing centre), the skills each covers, and the centre's rules (centre-rules/1) with the settings in force now: weekly_cap appointments per Monday-to-Sunday week across services, the cancellation cutoff (cancel_cutoff_hours before the start; a later cancellation is a late cancellation, which counts as a no-show), and a suspension of suspension_days when no_show_limit no-shows fall within no_show_window_days. Times are in the student's time zone with its UTC offset; every read returns the current virtual time as as_of and changes nothing.",
    "read_only": true,
    "scope": "tutorwell.services.list",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "tutorwell"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "rule_version": {
          "const": "centre-rules/1"
        },
        "settings": {
          "type": "object",
          "properties": {
            "weekly_cap": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "cancel_cutoff_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 168
            },
            "no_show_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "no_show_window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "suspension_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          },
          "required": [
            "weekly_cap",
            "cancel_cutoff_hours",
            "no_show_limit",
            "no_show_window_days",
