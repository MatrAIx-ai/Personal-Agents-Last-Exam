{
  "name": "@pale/app-pegboard",
  "version": "1.0.0",
  "private": true,
  "description": "Pegboard: a synthetic staff-scheduling app seen from one hourly employee's account, for PALE",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/business.test.cjs",
    "example": "node examples/run.cjs",
    "test:mcp": "node tests/mcp.integration.cjs",
    "test:mail": "node tests/mail.integration.cjs",
    "test:dataset": "node tests/dataset.integration.cjs",
    "check:fixture": "node dev/check-fixture.cjs",
    "check:contracts": "node dev/build.cjs --check",
    "check:walk": "node dev/walk.cjs",
    "dataset": "node dev/dataset.cjs && node dev/coverage.cjs",
    "check:dataset": "node dev/dataset.cjs --check && node dev/coverage.cjs --check",
    "web": "node examples/web.cjs",
    "test:web": "node tests/web.browser.cjs"
  },
  "license": "MIT"
}
