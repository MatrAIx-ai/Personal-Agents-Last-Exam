          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "actor": {
                  "enum": [
                    "me",
                    "coworker",
                    "manager"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "state": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "person_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
