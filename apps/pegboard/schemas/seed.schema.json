          },
          "start": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": [
          "weekday",
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "maxItems": 21
    },
    "time_off": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "state": {
            "enum": [
              "pending",
              "approved",
              "denied",
              "cancelled"
            ]
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "actor": {
                  "enum": [
                    "me",
                    "coworker",
                    "manager"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "state": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "person_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
