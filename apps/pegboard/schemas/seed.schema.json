{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pegboard workplace and account records",
  "description": "History accepted by env.load_seed and kept as App data. Workplace records (policy, locations, positions, people, posted weeks, shifts with their history) and one employee account (availability, time off, handoffs, preferences, notifications, activity). Everything in a seed has already happened. Time-based states are not stored: a shift carries its start and end, a handoff its cut-off, a time-off entry its first day and a notification its release time, and all are read against the environment clock.",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "workplace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "week_start": {
          "enum": [
            "sunday",
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "policy": {
          "type": "object",
          "properties": {
            "min_rest_hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "max_weekly_hours": {
              "type": "number",
              "minimum": 1,
              "maximum": 168
            },
            "handoff_cutoff_hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 168
            },
            "time_off_notice_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 90
            },
            "manager_approval": {
              "type": "boolean"
            }
          },
          "required": [
            "min_rest_hours",
            "max_weekly_hours",
            "handoff_cutoff_hours",
            "time_off_notice_days",
            "manager_approval"
          ],
          "additionalProperties": false
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "hourly_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "id",
              "name",
              "hourly_rate"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "id",
        "name",
        "timezone",
        "week_start",
        "currency",
        "policy",
        "locations",
        "positions"
      ],
      "additionalProperties": false
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "enum": [
              "employee",
              "manager"
            ]
          },
          "position_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 30,
            "uniqueItems": true
          },
          "max_weekly_hours": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 1,
                "maximum": 168
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "position_ids",
          "max_weekly_hours"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week_start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "week_start",
          "posted_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 520
    },
    "shifts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "location_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "position_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "assignee": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              }
            ]
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "by": {
                  "enum": [
                    "schedule",
                    "manager",
                    "handoff"
                  ]
                },
                "event_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "handoff_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "changed_by": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "change": {
                  "type": "object",
                  "properties": {
                    "posted": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "null"
                        },
                        "to": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                            }
                          ]
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "start": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "to": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "end": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "to": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "position_id": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "location_id": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "assignee": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                            }
                          ]
                        },
                        "to": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                            }
                          ]
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "cancelled": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "boolean"
                        },
                        "to": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "at",
                "by",
                "change"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "location_id",
          "position_id",
          "start",
          "end",
          "assignee",
          "history"
        ],
        "additionalProperties": false
