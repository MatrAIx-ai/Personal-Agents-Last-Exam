  "schema": "fernshelf.dependency.mail.v1",
  "dependency": "Mail notices (optional, send-only)",
  "reproducible": "Byte for byte, on Node 18 and 22: the wall-clock times the Messaging router and Mail record (received_at, committed_at, processed_at, in UTC) are written as \"<wall-clock>\" and the Node version is not recorded; everything else (virtual-clock times, versions, request, event and record IDs, hashes, receipt contents) is exact. `node scripts/dependency-evidence.cjs --check` regenerates the transcript twice and compares both runs with this file.",
  "revisions": {
    "fernshelf": "1.0.0",
    "mail": "1.3.0",
    "runtime": "1.6.0",
    "messaging_router": "1.2.0"
  },
  "contract": {
    "channel": "channel.email",
    "wire_schema": "urn:pale:email-message:2",
    "payload_schema": "urn:pale:email-payload:1",
    "event_type": "org.pale.mail.notification.v1",
    "receiver_operation": "mail.receive_notification (through Core env.apply_event on the Mail instance)",
    "fernshelf_declaration": "contribution/contribution.json messaging.publishes[0]",
    "mail_declaration": "examples/apps/mail/contribution/contribution.json messaging.receives[0]",
    "fernshelf_wire_schema_sha256": "74d5a4b4406b7ac1870dbecc114cae3f8978846a6e9999b46d33b7470598b4f0",
    "mail_wire_schema_sha256": "74d5a4b4406b7ac1870dbecc114cae3f8978846a6e9999b46d33b7470598b4f0"
  },
  "meanings": {
    "local_commit": "Fernshelf committed the notification and its wire message in its own state when the event was applied.",
    "receiver_commit": "The router returned committed only after Mail's env.apply_event committed; Mail's env.event_status and mail.get show the record.",
    "recipient_confirmation": "Not established by this flow: the Mail record is unread and nobody acts on it."
  },
  "passed": true,
  "checks": [
    "Fernshelf publishes the exact wire schema Mail 1.3.0 receives",
    "The notification stored its wire message (email notices on)",
    "Router commits the delivery to the Mail account mail-maya",
    "Mail holds one new inbox record whose ID is the delivery event ID",
    "The Mail record carries the notification title and body, unread",
    "Mail's committed receipt names the same event",
    "Fernshelf is unchanged by the dispatch",
    "An identical retry returns the first receipt marked duplicate",
    "A new request ID for the same message reaches the same Mail event; still one inbox record",
    "A lost acknowledgement is reported as unknown with the event ID and no commit time, and stops the run",
    "Mail's own receipt shows the message was committed",
    "The halted run refuses further publishing until it is reconciled",
    "Fernshelf is unchanged",
    "Rejected with recipient_not_authorized; Mail and Fernshelf unchanged",
    "With email notices off the notification has no wire message and nothing is published",
    "Without Mail the delivery is rejected as recipient_unavailable and Fernshelf is unchanged and usable",
    "A receiver with a different contract is refused as incompatible_contract; neither App changes"
  ],
