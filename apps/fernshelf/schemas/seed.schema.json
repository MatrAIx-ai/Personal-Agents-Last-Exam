{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fernshelf account seed",
  "description": "One account holder's photo library with its history: items, stacks, people labels, albums with members and contributions, links with views and saves, removal requests, notifications and activity. Generated by scripts/build-contracts.cjs.",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "account": {
      "$ref": "seed.schema.json#/$defs/account"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/person"
      },
      "maxItems": 500
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/label"
      },
      "maxItems": 200
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/item"
      },
      "maxItems": 5000
    },
    "stacks": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/stack"
      },
      "maxItems": 1000
    },
    "albums": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/album"
      },
      "maxItems": 500
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/link"
      },
      "maxItems": 500
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/view"
      },
      "maxItems": 5000
    },
    "removals": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/removal"
      },
      "maxItems": 500
    },
    "notifications": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/notification"
      },
      "maxItems": 5000
    },
    "activity": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/activity"
      },
      "maxItems": 20000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "account",
    "people",
    "labels",
    "items",
    "stacks",
    "albums",
    "links",
    "views",
    "removals",
    "notifications",
    "activity"
  ],
  "additionalProperties": false,
  "$defs": {
    "account": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quota_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000000
        },
        "trash_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "email_notices": {
          "type": "boolean"
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "display_name",
        "plan",
        "quota_bytes",
        "trash_retention_days",
        "time_zone",
        "email_notices",
        "opened_at"
      ],
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "properties": {
        "person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "person_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "person_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "person_id"
      ],
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "lat",
        "lon"
      ],
      "additionalProperties": false
    },
    "history_row": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "actor": {
          "enum": [
            "seed",
            "agent",
            "event"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "object"
        }
      },
      "required": [
        "at",
        "action",
        "actor",
        "request_id",
        "event_id"
      ],
      "additionalProperties": false
    },
    "removal_row": {
      "type": "object",
      "properties": {
        "removal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "album_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "uniqueItems": true
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "removal_id",
        "person_id",
        "album_ids",
        "at"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "kind": {
          "enum": [
            "photo",
            "video"
          ]
        },
        "taken_at": {
          "type": "string",
          "format": "date-time"
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "seed.schema.json#/$defs/place"
            },
            {
              "type": "null"
            }
          ]
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "caption": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "camera",
            "screenshot",
            "download",
            "saved_from_share"
          ]
        },
        "favorite": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "backed_up": {
          "type": "boolean"
        },
        "declared_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000000
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "active",
            "trashed",
            "purged"
          ]
        },
        "trashed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "purge_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "purged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "saved_from": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "album_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "contribution_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "person_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                }
              },
              "required": [
                "album_id",
                "contribution_id",
                "person_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "removal_history": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/removal_row"
          },
          "maxItems": 100
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/history_row"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "id",
        "kind",
        "taken_at",
        "added_at",
        "place",
        "people",
        "caption",
        "source",
        "favorite",
        "archived",
        "backed_up",
        "declared_bytes",
        "content_hash",
        "width",
        "height",
        "duration_ms",
        "file",
        "state",
        "trashed_at",
        "purge_at",
        "purged_at",
        "saved_from",
        "removal_history",
        "history"
      ],
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "kind": {
          "enum": [
            "edit",
            "burst",
            "duplicate"
          ]
        },
        "cover_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 100
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "cover_id",
        "item_ids",
        "created_at"
      ],
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "kind": {
          "enum": [
            "photo",
            "video"
          ]
        },
        "taken_at": {
          "type": "string",
          "format": "date-time"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "seed.schema.json#/$defs/place"
            },
            {
              "type": "null"
            }
          ]
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "caption": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000000
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        },
        "removed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_reason": {
          "anyOf": [
            {
              "enum": [
                "withdrawn",
                "member_left",
                "member_removed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "person_id",
        "kind",
        "taken_at",
        "place",
        "people",
        "caption",
        "declared_bytes",
        "content_hash",
        "width",
        "height",
        "added_at",
        "removed_at",
        "removed_reason",
        "event_id"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "role": {
          "enum": [
            "viewer",
            "contributor"
          ]
        },
        "status": {
          "enum": [
            "invited",
            "joined",
            "declined",
            "left",
            "removed"
          ]
        },
        "invited_at": {
          "type": "string",
          "format": "date-time"
        },
        "joined_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/history_row"
          },
          "maxItems": 200
        }
      },
      "required": [
        "person_id",
        "role",
        "status",
        "invited_at",
        "joined_at",
        "ended_at",
        "history"
      ],
      "additionalProperties": false
    },
    "album": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "enum": [
            "seed",
            "agent"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "uniqueItems": true,
          "maxItems": 5000
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/member"
          },
          "maxItems": 100
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/contribution"
          },
          "maxItems": 2000
        },
        "deleted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "created_at",
        "created_by",
        "request_id",
        "item_ids",
        "members",
        "contributions",
        "deleted_at"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "album_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoke_reason": {
          "anyOf": [
            {
              "enum": [
                "revoked",
                "album_deleted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "album_id",
        "created_at",
        "expires_at",
        "revoked_at",
        "revoke_reason",
        "request_id"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "surface": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "link",
                "album"
              ]
            },
            "album_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "link_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "album_id",
            "link_id"
          ],
          "additionalProperties": false
        },
        "viewer": {
          "type": "object",
          "properties": {
            "person_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
