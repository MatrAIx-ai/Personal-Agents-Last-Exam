                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "allocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "member_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                      },
                      "amount_minor": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "basis_points": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "shares": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "member_id"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "description",
            "date",
            "category",
            "amount_minor",
            "currency",
            "payers",
            "split"
          ],
          "additionalProperties": false
        },
        "expected_version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        }
      },
      "required": [
        "mode",
        "group_id",
        "expected_version",
        "request_id"
      ],
      "additionalProperties": false
    },
