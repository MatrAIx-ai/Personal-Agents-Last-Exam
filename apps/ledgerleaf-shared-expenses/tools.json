    "resource_target": "current Ledgerleaf account and authorized group objects",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        },
        "expense_id": {
