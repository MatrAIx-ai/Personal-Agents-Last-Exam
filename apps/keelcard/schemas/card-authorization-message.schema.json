{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:card-authorization-message:1",
  "title": "CloudEvents 1.0 card authorization message",
  "type": "object",
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 150 },
    "source": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$", "maxLength": 512 },
    "type": { "const": "org.pale.card.authorization.v1" },
    "time": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "const": "urn:pale:card-authorization-payload:1" },
    "data": {
      "type": "object",
      "properties": {
        "channel": { "const": "channel.card.authorization" },
        "recipient": {
          "type": "object",
          "properties": {
            "kind": { "const": "app_account_ref" },
            "app_id": { "const": "keelcard" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" }
          },
          "required": ["kind", "app_id", "id"],
          "additionalProperties": false
        },
        "source_object": {
          "type": "object",
          "properties": {
            "app_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
            "account_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
            "object_type": { "type": "string", "minLength": 1, "maxLength": 80 },
            "object_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" }
          },
          "required": ["app_id", "account_id", "object_type", "object_id"],
          "additionalProperties": false
        },
        "authorization": {
          "type": "object",
          "properties": {
            "authorization_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
            "card": {
              "type": "object",
              "properties": {
                "card_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
                "number": { "type": "string", "pattern": "^9[0-9]{15}$" },
                "expiry": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
                "security_code": { "type": "string", "pattern": "^[0-9]{3,4}$" }
              },
              "additionalProperties": false
            },
            "merchant": {
              "type": "object",
              "properties": {
                "merchant_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                "category": {
                  "type": "string",
                  "enum": [
                    "grocery",
                    "restaurants",
                    "travel",
                    "telecom",
                    "domains_hosting",
                    "digital_goods",
                    "crypto",
                    "gift_cards",
                    "healthcare",
                    "utilities",
                    "entertainment",
                    "education",
                    "transport",
                    "general_merchandise"
                  ]
                }
              },
              "required": ["merchant_id", "name", "category"],
              "additionalProperties": false
            },
            "amount_cents": { "type": "integer", "minimum": 1 },
            "currency": { "const": "USD" }
          },
          "required": ["authorization_key", "card", "merchant", "amount_cents", "currency"],
          "additionalProperties": false
        },
        "extensions": { "type": "array", "maxItems": 0 }
      },
      "required": ["channel", "recipient", "source_object", "authorization", "extensions"],
      "additionalProperties": false
    }
  },
  "required": ["specversion", "id", "source", "type", "datacontenttype", "dataschema", "data"],
  "additionalProperties": false
}
