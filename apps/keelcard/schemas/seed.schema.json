          "hold_cents": {
            "type": "integer",
            "minimum": 0
          },
          "captured_cents": {
            "type": "integer",
            "minimum": 0
          },
          "refunded_cents": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
