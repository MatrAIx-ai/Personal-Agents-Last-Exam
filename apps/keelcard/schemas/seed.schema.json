                  "account_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "object_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "app_id",
                  "account_id",
                  "object_type",
