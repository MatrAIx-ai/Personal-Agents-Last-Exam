{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "time_zone": {
      "const": "America/New_York"
    },
    "verification": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "email_code",
            "owner_approval"
          ]
        },
        "code_ttl_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "owner_window_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      },
      "required": [
        "mode",
        "code_ttl_minutes",
        "max_attempts",
        "owner_window_hours"
      ],
      "additionalProperties": false
    },
    "delegate": {
      "type": "object",
      "properties": {
        "may_reveal": {
          "type": "boolean"
        },
        "card_ceiling_cents": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "may_reveal",
        "card_ceiling_cents"
      ],
      "additionalProperties": false
    },
    "funding": {
      "type": "object",
      "properties": {
        "opening_balance_cents": {
          "type": "integer",
          "minimum": 0
        },
        "balance_cents": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        }
      },
      "required": [
        "opening_balance_cents",
        "balance_cents",
        "currency"
      ],
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "properties": {
        "declines": {
          "type": "boolean"
        },
        "receipts": {
          "type": "boolean"
        },
        "codes": {
          "type": "boolean"
        },
        "card_events": {
          "type": "boolean"
        },
        "disputes": {
          "type": "boolean"
        },
        "decline_threshold_cents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "declines",
        "receipts",
        "codes",
        "card_events",
        "disputes",
        "decline_threshold_cents"
      ],
      "additionalProperties": false
    },
    "category_blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grocery",
          "restaurants",
          "travel",
          "telecom",
          "domains_hosting",
          "digital_goods",
          "crypto",
          "gift_cards",
          "healthcare",
          "utilities",
          "entertainment",
          "education",
          "transport",
          "general_merchandise"
        ]
      },
      "uniqueItems": true
    },
    "merchant_blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
      },
      "uniqueItems": true
    },
    "merchants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "grocery",
              "restaurants",
              "travel",
              "telecom",
              "domains_hosting",
              "digital_goods",
              "crypto",
              "gift_cards",
              "healthcare",
              "utilities",
              "entertainment",
              "education",
              "transport",
              "general_merchandise"
            ]
          }
        },
        "required": [
          "merchant_id",
          "name",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "cards": {
