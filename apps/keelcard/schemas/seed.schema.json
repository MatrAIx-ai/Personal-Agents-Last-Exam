              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "authorization_id",
          "authorization_key",
          "content_key",
          "card_id",
          "merchant_id",
          "merchant_name",
          "category",
          "amount_cents",
          "currency",
          "merchant_ref",
          "source_event_id",
          "decided_at",
          "limits_in_force",
          "redelivered_at",
          "decision",
          "decline_code",
          "status",
          "hold_cents",
          "captured_cents",
          "refunded_cents",
          "expires_at",
          "captured_at",
          "expired_at",
          "reversed_at",
          "settled_at",
          "capture_key"
