          "number": {
            "type": "string",
            "pattern": "^9[0-9]{15}$"
          },
          "expiry": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "security_code": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "closed"
            ]
          },
          "paused_by": {
            "anyOf": [
              {
                "enum": [
                  "owner",
                  "delegate"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "closure_reason": {
            "anyOf": [
              {
                "enum": [
                  "closed",
                  "single_use"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "merchant_lock": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "grocery",
                "restaurants",
                "travel",
                "telecom",
                "domains_hosting",
                "digital_goods",
                "crypto",
                "gift_cards",
                "healthcare",
                "utilities",
                "entertainment",
                "education",
                "transport",
                "general_merchandise"
              ]
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "per_transaction": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "per_day": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "per_month": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lifetime": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "per_transaction",
              "per_day",
              "per_month",
              "lifetime"
            ],
            "additionalProperties": false
          },
          "funding_source": {
            "const": "local"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
