{
  "schema_version": 1,
  "app_id": "keelcard",
  "version": "1.0.0",
  "core_api_version": "1.2.0",
  "maintainer": {
    "contact": "Repository issue / PR tagged app:keelcard"
  },
  "license": "MIT",
  "entrypoint": "plugin.cjs",
  "service": "service.cjs",
  "tools": "tools.json",
  "schemas": {
    "seed": "schemas/seed.schema.json",
    "state": "schemas/state.schema.json",
    "events": "schemas/events.schema.json"
  },
  "fixtures": {
    "seed": "fixtures/minimal.json",
    "binding": "fixtures/binding.json",
    "policies": "fixtures/policies.json"
  },
  "dependencies": [],
  "event_types": [
    "authorization.request",
    "authorization.capture",
    "authorization.reverse",
    "refund.issue",
    "funding.top_up",
    "change_request.owner_decision",
    "dispute.update",
    "ledger.settle_due",
    "notice.delivery_result"
  ],
  "capabilities": {
    "modes": [
      "synthetic"
    ],
    "resources": true,
    "ui": "reviewer renderer",
    "real_delivery": false
  },
  "limitations": [
    "v1 excludes real card networks, physical cards, credit, rewards, other currencies, and a link to an external funding account."
  ],
  "dataset": "contribution/dataset.json",
  "resources": {
    "catalog": "contribution/assets.catalog.json",
    "directory": "assets"
  },
  "contribution": "contribution/contribution.json"
}
