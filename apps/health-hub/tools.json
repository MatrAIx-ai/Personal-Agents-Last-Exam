[
  {
    "name": "health-hub.get_daily_summary",
    "description": "Retrieve wearable daily sleep, strain, and recovery metrics for a specific date (YYYY-MM-DD).",
    "read_only": true,
    "scope": "health-hub:read",
    "resource_target": "daily_summary",
    "inputSchema": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": ["status", "app_id", "version", "summary"],
      "properties": {
        "status": { "type": "string" },
        "app_id": { "type": "string" },
        "version": { "type": "object" },
        "summary": { "type": "object" }
      }
    }
  },
  {
    "name": "health-hub.list_metrics",
    "description": "List time-series metrics (sleep, recovery, strain, body_weight) across a date window.",
    "read_only": true,
    "scope": "health-hub:read",
    "resource_target": "daily_summary",
    "inputSchema": {
      "type": "object",
      "required": ["metric_type", "start_date", "end_date"],
      "properties": {
        "metric_type": { "type": "string", "enum": ["sleep", "recovery", "strain", "body_weight"] },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": ["status", "app_id", "version", "metric_type", "series"],
      "properties": {
        "status": { "type": "string" },
        "app_id": { "type": "string" },
        "version": { "type": "object" },
        "metric_type": { "type": "string" },
        "series": { "type": "array" }
      }
    }
  },
