[
  {
    "name": "health-hub.get_daily_summary",
    "description": "Retrieve wearable daily sleep, strain, and recovery metrics for a specific date (YYYY-MM-DD).",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  {
    "name": "health-hub.list_metrics",
    "description": "List time-series metrics (sleep, rhr, hrv, strain, body_weight) across a date window.",
