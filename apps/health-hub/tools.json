        "activity_type": { "type": "string" },
        "scheduled_at": { "type": "string" },
        "duration_minutes": { "type": "number", "minimum": 1 },
        "expected_version": { "type": "object" },
        "request_id": { "type": "string" }
      }
    }
  },
  {
    "name": "health-hub.log_workout",
