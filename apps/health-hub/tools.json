    "input_schema": {
      "type": "object",
      "required": ["metric_type", "start_date", "end_date"],
      "properties": {
        "metric_type": { "type": "string", "enum": ["sleep", "recovery", "strain", "body_weight"] },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  {
