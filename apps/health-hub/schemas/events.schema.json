{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["event_id", "at", "operation", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "at": { "type": "string", "format": "date-time" },
    "operation": { 
      "type": "string", 
      "enum": ["health-hub.ingest_daily_sync"] 
    },
    "payload": {
      "type": "object",
      "required": ["date", "sleep", "recovery", "day_strain"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sleep": {
          "type": "object",
          "required": ["duration_minutes", "deep_sleep_minutes", "rem_sleep_minutes", "sleep_score"],
          "properties": {
            "duration_minutes": { "type": "number", "minimum": 0 },
            "deep_sleep_minutes": { "type": "number", "minimum": 0 },
            "rem_sleep_minutes": { "type": "number", "minimum": 0 },
            "sleep_score": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "recovery": {
          "type": "object",
          "required": ["resting_hr", "hrv_rmssd", "recovery_score"],
          "properties": {
            "resting_hr": { "type": "number", "minimum": 30, "maximum": 200 },
            "hrv_rmssd": { "type": "number", "minimum": 5, "maximum": 250 },
            "recovery_score": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "day_strain": { "type": "number", "minimum": 0.0, "maximum": 21.0 }
      }
    }
  }
}
