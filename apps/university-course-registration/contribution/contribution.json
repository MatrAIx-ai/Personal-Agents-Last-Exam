{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "university-course-registration",
  "app_categories": [
    "external"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "university-course-registration.catalog.search",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.course.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.record.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.schedule.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.waitlist.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.activity.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.change.preview",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.enrollment.enroll",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.enrollment.withdraw",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.enrollment.swap",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.waitlist.join",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.waitlist.leave",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.offer.accept",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "university-course-registration.offer.decline",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "Per-App lock and optimistic epoch/revision check; one student account per App instance, competitors act through Infra events on the same ledger",
    "commit_confirmation": "committed + epoch/revision + App receipt ID listed in activity; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "university-course-registration.occupancy.change",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "university-course-registration.section.reschedule",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "university-course-registration.offers.expire",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": "gui.json",
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [],
    "implemented_storage_adapters": [],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
