{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:curbline:seed:1",
  "title": "Curbline account and world data",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "settings": {
      "$ref": "seed.schema.json#/$defs/settings"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/zone"
      },
      "maxItems": 50
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/place"
      },
      "maxItems": 500
    },
    "travel": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/travel"
      },
      "maxItems": 2500
    },
    "supply": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/supply"
      },
      "maxItems": 500
    },
    "market": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/market"
      },
      "maxItems": 50
    },
    "flights": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/flight"
      },
      "maxItems": 500
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/payment_method"
      },
      "maxItems": 20
    },
    "bookings": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/booking"
      },
      "maxItems": 2000
    },
    "ledger": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/ledger_entry"
      },
      "maxItems": 10000
    },
    "shares": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/share"
      },
      "maxItems": 2000
    },
    "support_cases": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/support_case"
      },
      "maxItems": 500
    },
    "notifications": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/notification"
      },
      "maxItems": 20000
    },
    "ignored_events": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/ignored_event"
      },
      "maxItems": 5000
