          "additionalProperties": false
        },
        "distance_km": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "band": {
          "enum": [
            "night",
            "offpeak",
            "peak"
          ]
        },
        "fare_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "market_revision": {
          "type": "integer",
          "minimum": 0
        },
        "quoted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fare_cents",
        "breakdown",
        "distance_km",
        "minutes",
        "band",
        "fare_version",
        "market_revision",
        "quoted_at"
      ],
      "additionalProperties": false
    },
    "history_entry": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "enum": [
            "agent",
            "infra",
            "clock",
            "seed"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "from": {
          "anyOf": [
            {
              "enum": [
                "scheduled",
                "driver_assigned",
                "driver_arrived",
                "on_trip",
                "needs_attention",
                "completed",
                "cancelled",
                "rider_no_show",
                "lapsed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "enum": [
                "scheduled",
                "driver_assigned",
                "driver_arrived",
                "on_trip",
                "needs_attention",
                "completed",
                "cancelled",
                "rider_no_show",
                "lapsed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "at",
        "actor",
        "action",
        "from",
        "to",
        "details",
        "event_id"
      ],
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "properties": {
        "driver_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "driver_id",
        "first_name"
      ],
      "additionalProperties": false
    },
    "vehicle": {
      "type": "object",
      "properties": {
        "vehicle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "make_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "plate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      },
      "required": [
        "vehicle_id",
        "make_model",
        "color",
        "plate"
      ],
      "additionalProperties": false
    },
