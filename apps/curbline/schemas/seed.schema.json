                "since": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "reason",
                "proposed_pickup_at",
                "since"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "pickup_place_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "dropoff_place_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "pickup_at": {
          "type": "string",
          "format": "date-time"
