  },
  "required": [
    "account_id",
    "owner_person_id",
    "settings",
    "zones",
    "places",
    "travel",
    "supply",
    "market",
    "flights",
    "payment_methods",
    "bookings",
    "ledger",
    "shares",
    "support_cases",
    "notifications",
    "ignored_events"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "flight_key": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2}$"
        },
        "number": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$"
        },
        "local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "carrier",
        "number",
        "local_date"
      ],
      "additionalProperties": false
    },
    "external_ref": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "app_id",
        "account_id",
        "object_id"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "auto_shift_max_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      },
      "required": [
        "time_zone",
        "auto_shift_max_min"
      ],
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "zone_id",
        "name",
        "time_zone"
      ],
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "place_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "address",
            "hotel",
            "venue",
            "airport_terminal"
          ]
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "airport_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "airport_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "place_id",
        "name",
        "kind",
        "zone_id",
        "time_zone",
        "airport_code",
        "airport_name",
        "terminal",
        "address"
      ],
      "additionalProperties": false
    },
    "travel": {
      "type": "object",
      "properties": {
        "from_zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "to_zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "km": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "minutes": {
          "type": "object",
          "properties": {
            "night": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "offpeak": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "peak": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          },
          "required": [
            "night",
            "offpeak",
            "peak"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "from_zone",
        "to_zone",
        "km",
        "minutes"
      ],
      "additionalProperties": false
    },
    "supply": {
      "type": "object",
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "option": {
          "enum": [
            "standard",
            "xl",
            "comfort",
            "wheelchair_accessible"
          ]
        },
        "night": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "offpeak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "peak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "zone_id",
        "option",
        "night",
        "offpeak",
        "peak"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "multiplier": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "supply": {
          "type": "object",
          "properties": {
            "standard": {
              "type": "object",
              "properties": {
                "night": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "offpeak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "peak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "xl": {
              "type": "object",
              "properties": {
                "night": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "offpeak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "peak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "comfort": {
              "type": "object",
              "properties": {
                "night": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "offpeak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "peak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "wheelchair_accessible": {
              "type": "object",
              "properties": {
                "night": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "offpeak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "peak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "zone_id",
        "multiplier",
        "revision",
        "updated_at",
        "supply"
      ],
      "additionalProperties": false
    },
    "flight": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2}$"
        },
        "number": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$"
        },
        "local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduled_arrival": {
          "type": "string",
          "format": "date-time"
        },
        "estimated_arrival": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrival_place_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "status": {
          "enum": [
            "scheduled",
            "on_time",
            "delayed",
            "early",
            "cancelled",
            "diverted",
            "landed"
          ]
        },
        "landed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
