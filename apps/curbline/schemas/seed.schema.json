          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "scheduled",
                  "on_time",
                  "delayed",
                  "early",
                  "cancelled",
                  "diverted",
                  "landed"
                ]
              },
              "estimated_arrival": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "arrival_place_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "event_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "at",
              "status",
              "estimated_arrival",
              "arrival_place_id",
              "event_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "carrier",
        "number",
        "local_date",
        "scheduled_arrival",
        "estimated_arrival",
        "arrival_place_id",
        "status",
        "landed_at",
        "source_ref",
        "history"
      ],
      "additionalProperties": false
    },
    "payment_method": {
      "type": "object",
      "properties": {
        "payment_method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "last4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile": {
          "enum": [
            "personal",
            "business"
          ]
        },
        "declines": {
          "type": "boolean"
        }
      },
      "required": [
        "payment_method_id",
        "brand",
        "last4",
        "label",
        "profile",
        "declines"
      ],
      "additionalProperties": false
    },
    "fare": {
      "type": "object",
      "properties": {
        "fare_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "base_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "distance_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "time_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "multiplier": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 5
            },
            "surge_cents": {
              "type": "integer",
              "minimum": -10000000,
              "maximum": 10000000
            },
            "booking_fee_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "airport_fee_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            }
