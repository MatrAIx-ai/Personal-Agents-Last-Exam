      "type": "object",
      "properties": {
        "booking_id": {
          "type": "string",
          "pattern": "^bk-[0-9]{1,6}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "scheduled",
            "driver_assigned",
            "driver_arrived",
            "on_trip",
            "needs_attention",
            "completed",
            "cancelled",
            "rider_no_show",
            "lapsed"
          ]
        },
        "attention": {
