{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bellnote incoming events",
  "description": "Events from the school office, the cafeteria and the other guardian, applied by Infra with env.apply_event. Generated by scripts/build-contracts.cjs.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "enum": [
        "bellnote.attendance.marked",
        "bellnote.absence.reviewed",
        "bellnote.form.published",
        "bellnote.form.changed",
        "bellnote.form.answered",
        "bellnote.pickup.person_reviewed",
        "bellnote.dismissal.recorded",
        "bellnote.lunch.charged",
        "bellnote.school.day_changed"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "operation": {
          "const": "bellnote.attendance.marked"
        },
        "payload": {
          "type": "object",
          "properties": {
            "child_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "status": {
              "enum": [
                "present",
                "absent",
                "late",
                "left_early"
              ]
            },
            "time_local": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "marked_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "child_id",
            "date",
            "status",
            "marked_by"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.absence.reviewed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "decision": {
              "enum": [
                "excused",
                "unexcused"
              ]
            },
            "reviewed_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "report_id",
            "decision",
            "reviewed_by"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.form.published"
        },
        "payload": {
          "type": "object",
          "properties": {
            "form_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "school_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "child_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "kind": {
              "enum": [
                "permission_slip",
                "medication",
                "medical_consent",
                "information"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "type": {
                    "enum": [
                      "text",
                      "choice",
                      "boolean",
                      "number"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 2,
                    "maxItems": 20
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label",
                  "required"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            "fee_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "event_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "form_id",
            "school_id",
            "child_ids",
            "kind",
            "title",
            "text",
            "questions",
            "fee_cents",
            "due_at"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.form.changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "form_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "change": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "type": {
                        "enum": [
                          "text",
                          "choice",
                          "boolean",
                          "number"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "minItems": 2,
                        "maxItems": 20
                      },
                      "required": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "type",
                      "label",
                      "required"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 30
                },
                "fee_cents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "event_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "due_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "form_id",
            "change",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.form.answered"
        },
        "payload": {
          "type": "object",
          "properties": {
            "form_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "child_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "by_guardian_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "action": {
              "enum": [
                "sign",
                "decline",
                "withdraw"
              ]
            },
            "form_version": {
              "type": "integer",
              "minimum": 1
            },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "form_id",
            "child_id",
            "by_guardian_id",
            "action"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.pickup.person_reviewed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "pickup_person_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "decision": {
              "enum": [
                "approve",
                "deny",
                "revoke"
              ]
            },
            "reviewed_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "required": [
            "pickup_person_id",
            "decision",
            "reviewed_by"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.dismissal.recorded"
        },
        "payload": {
          "type": "object",
          "properties": {
            "change_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "child_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "mode": {
              "enum": [
                "pickup",
                "bus",
                "after_care",
                "walker"
              ]
            },
            "person_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recorded_by": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "change_id",
            "child_id",
            "date",
            "mode",
            "recorded_by"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.lunch.charged"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transaction_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "child_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "kind": {
              "enum": [
                "purchase",
                "refund",
                "adjustment"
              ]
            },
            "amount_cents": {
              "type": "integer",
              "minimum": -10000000,
              "maximum": 10000000
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "allergens": {
              "type": "array",
              "items": {
                "enum": [
                  "peanut",
                  "tree_nut",
                  "milk",
                  "egg",
                  "wheat",
                  "soy",
                  "fish",
                  "shellfish",
                  "sesame"
                ]
              },
              "uniqueItems": true
            },
            "payment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "transaction_id",
            "child_id",
            "kind",
            "amount_cents"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "bellnote.school.day_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "school_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "kind": {
              "enum": [
                "closed",
                "early_dismissal"
              ]
            },
            "dismissal_local": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "school_id",
            "date",
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
