  {
    "name": "milepost.mastery.get",
    "description": "Current mastery level of each skill (or of the listed skills) and when it was last practised, under learner rule milepost-learner/1. Levels fade with the time since practice. An unknown skill returns not_found.",
    "read_only": true,
    "scope": "milepost.mastery.get",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "maxItems": 500,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "milepost"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "rule_version": {
          "const": "milepost-learner/1"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "level": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "last_practised_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "skill_id",
              "level",
              "last_practised_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "as_of",
        "rule_version",
        "skills"
      ],
      "additionalProperties": false
    }
  },
