[
  {
    "name": "milepost.courses.list",
    "description": "List the student's courses with their units and the skills in each unit. Reads change nothing; every read returns the current virtual time as as_of.",
    "read_only": true,
    "scope": "milepost.courses.list",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "milepost"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "position": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "skill_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "maxItems": 500
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "position",
                    "skill_ids"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              }
            },
            "required": [
              "id",
              "title",
              "units"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "as_of",
        "courses"
      ],
      "additionalProperties": false
    }
  },
