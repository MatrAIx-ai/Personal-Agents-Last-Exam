{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:wirewalk:events:1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "post.publish"
    },
    "payload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "kind": {
          "enum": [
            "original",
            "reply",
            "quote",
            "repost"
          ]
        },
        "author_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "parent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "quoted_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://([a-z0-9-]+\\.)+example(/[A-Za-z0-9._~%/?=&#@:-]*)?$",
                "maxLength": 300
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 500
              }
            },
            "required": [
              "url",
              "title",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 4
        }
      },
      "required": [
        "id",
        "kind",
        "author_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false
}
