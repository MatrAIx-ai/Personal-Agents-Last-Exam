{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:dayline:events:1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "edition.publish"
    },
    "payload": {
      "type": "object",
      "properties": {
        "edition_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "story_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "outlet_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "section": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "geography": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "byline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edition_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "credit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "edition_id",
              "credit"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "front_page": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "edition_id",
        "story_id",
        "outlet_id",
        "section",
        "geography",
        "language",
        "headline",
        "byline",
        "text",
        "credits",
        "published_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false
}
