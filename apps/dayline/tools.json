  {
    "name": "dayline.search",
    "description": "Search published editions by words in the headline, text, byline, credits, outlet or story title (case- and accent-insensitive; every query word must match the start of a word, so \"air\" finds \"airport\" but not \"repair\"), with optional exact-match filters and an inclusive published_after/published_before window. Returns up to limit (default 20) editions, newest publication first; total counts every match. Does not mark anything read.",
    "read_only": true,
    "scope": "dayline.search",
    "resource_target": "current account",
