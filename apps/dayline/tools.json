  {
    "name": "dayline.outlets.list",
    "description": "List the publishers and desks whose editions Dayline carries, with their kind, language and home geography.",
    "read_only": true,
    "scope": "dayline.outlets.list",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "dayline"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "outlets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outlet_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "wire",
                  "local",
                  "regional",
                  "state",
                  "national",
                  "international"
                ]
              },
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
              },
              "geography": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1000
              }
            },
            "required": [
              "outlet_id",
              "name",
              "kind",
              "language",
              "geography",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "outlets"
      ],
      "additionalProperties": false
    }
  },
