{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShelfMark Public Library Seed",
  "type": "object",
  "required": [
    "schema_version",
    "account_id",
    "account",
    "branches",
    "titles",
    "rooms",
    "managed_cards",
    "loans",
    "holds",
    "fines",
    "room_bookings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "account": {
      "type": "object",
      "required": ["account_id", "owner_person_id", "display_name", "email", "household_daily_room_hours_quota"],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "owner_person_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "household_daily_room_hours_quota": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "address", "hours", "asset_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "hours": { "type": "string", "minLength": 1 },
          "asset_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "closed_until": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "closure_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "additionalProperties": false
      }
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "author", "isbn", "format", "subjects", "queued_patrons", "max_renewals", "loan_days", "copies"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "isbn": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["print", "large_print", "audiobook", "ebook", "museum_pass", "library_of_things"] },
          "subjects": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "queued_patrons": { "type": "integer", "minimum": 0 },
          "max_renewals": { "type": "integer", "minimum": 0 },
          "loan_days": { "type": "integer", "minimum": 1 },
          "cover_asset_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "copies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["copy_id", "branch_id", "status"],
              "properties": {
                "copy_id": { "type": "string", "minLength": 1 },
                "branch_id": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["available", "checked_out", "on_hold_shelf", "in_transit"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "branch_id", "name", "kind", "capacity", "amenities", "max_duration_minutes", "free_cancel_hours_before"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "branch_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["study_room", "museum_pass"] },
          "capacity": { "type": "integer", "minimum": 1 },
          "amenities": { "type": "array", "items": { "type": "string" } },
          "max_duration_minutes": { "type": "integer", "minimum": 30 },
          "free_cancel_hours_before": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "managed_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "holder_name", "role", "home_branch_id", "max_holds", "block_threshold_cents", "card_status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "holder_name": { "type": "string", "minLength": 1 },
          "person_ref": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "role": { "type": "string", "enum": ["parent", "child"] },
          "home_branch_id": { "type": "string", "minLength": 1 },
          "max_holds": { "type": "integer", "minimum": 1 },
          "block_threshold_cents": { "type": "integer", "minimum": 100 },
          "card_status": { "type": "string", "enum": ["active", "blocked_fines"] }
        },
        "additionalProperties": false
      }
    },
    "loans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title_id", "card_id", "branch_id", "checked_out_at", "due_at", "status", "renewals_used"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title_id": { "type": "string", "minLength": 1 },
          "card_id": { "type": "string", "minLength": 1 },
          "branch_id": { "type": "string", "minLength": 1 },
          "checked_out_at": { "type": "string", "minLength": 1 },
          "due_at": { "type": "string", "minLength": 1 },
          "returned_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "returned_branch_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "status": { "type": "string", "enum": ["active", "overdue", "returned"] },
          "renewals_used": { "type": "integer", "minimum": 0 },
          "note": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "history": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title_id", "card_id", "pickup_branch_id", "status", "queue_position", "placed_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title_id": { "type": "string", "minLength": 1 },
          "card_id": { "type": "string", "minLength": 1 },
          "pickup_branch_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["queued", "suspended", "ready_for_pickup", "checked_out", "expired", "cancelled"] },
          "queue_position": { "type": "integer", "minimum": 1 },
          "placed_at": { "type": "string", "minLength": 1 },
          "resume_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "ready_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "pickup_expires_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "closure_event_ids": { "type": "array", "items": { "type": "string" } },
          "history": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    },
    "fines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "card_id", "amount_cents", "reason", "status", "assessed_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "card_id": { "type": "string", "minLength": 1 },
          "loan_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "amount_cents": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["open", "disputed", "paid", "waived"] },
          "assessed_at": { "type": "string", "minLength": 1 },
          "paid_at": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "payment_receipt_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "dispute_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "dispute_note": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "decision_note": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "history": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    },
    "room_bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "room_id", "branch_id", "card_id", "start_at", "end_at", "free_cancel_cutoff_at", "status", "created_at", "confirmation_code"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "room_id": { "type": "string", "minLength": 1 },
          "branch_id": { "type": "string", "minLength": 1 },
          "card_id": { "type": "string", "minLength": 1 },
          "start_at": { "type": "string", "minLength": 1 },
          "end_at": { "type": "string", "minLength": 1 },
          "free_cancel_cutoff_at": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["confirmed", "cancelled", "no_show"] },
          "created_at": { "type": "string", "minLength": 1 },
          "confirmation_code": { "type": "string", "minLength": 1 },
          "purpose": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "late_cancellation": { "type": "boolean" },
          "waived_by_closure": { "type": "boolean" },
          "note": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "history": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
