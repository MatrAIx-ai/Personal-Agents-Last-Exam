            "quotes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "instrument_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "price_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9000000000000
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "available_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "valid_until": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "provider": {
                    "enum": [
                      "yahoo_chart",
                      "alphavantage_demo"
                    ]
                  },
                  "source_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "collected_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "raw_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "raw_price": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "delay_seconds": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9000000000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "interval": {
                    "enum": [
                      "1d",
                      "15m",
                      "quote"
                    ]
                  },
                  "price_kind": {
                    "enum": [
                      "last_trade",
                      "daily_reference",
                      "intraday_reference"
                    ]
                  },
                  "executable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "instrument_id",
                  "price_cents",
                  "as_of",
                  "available_at",
                  "valid_until",
                  "executable"
                ],
                "additionalProperties": false
              }
            },
            "history": {
              "type": "array",
              "items": {
                "$ref": "schemas/seed.schema.json#/$defs/bar"
              }
            },
            "announcements": {
              "type": "array",
              "items": {
                "$ref": "schemas/seed.schema.json#/$defs/announcement"
              }
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "$ref": "schemas/seed.schema.json#/$defs/market_source"
            }
          },
          "required": [
            "status",
            "app_id",
            "version",
