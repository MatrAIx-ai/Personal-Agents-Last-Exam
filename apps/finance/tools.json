  {
    "name": "finance.market.get",
    "description": "Read currently available quotes, history and announcements with source/mode metadata. Real observations remain reference prices for simulated fills. Expired quotes are non-executable.",
    "read_only": true,
    "scope": "finance.market.get",
    "resource_target": "owned accounts in the bound finance workspace",
    "inputSchema": {
      "type": "object",
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
