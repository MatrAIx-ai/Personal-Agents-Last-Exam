          "type": "integer",
          "minimum": -9000000000000,
          "maximum": 9000000000000
        }
      },
      "required": [
        "account_id",
        "amount_cents"
      ],
      "additionalProperties": false
    },
    "position_effect": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity_delta": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "cost_delta_cents": {
          "type": "integer",
          "minimum": -9000000000000,
          "maximum": 9000000000000
        }
      },
      "required": [
        "account_id",
        "instrument_id",
        "quantity_delta",
        "cost_delta_cents"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "credit",
            "debit"
          ]
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "recurrence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "account_id",
        "kind",
        "amount_cents",
        "description",
        "due_at",
        "recurrence",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "minimum_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "fee_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "assessment_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "account_id",
        "minimum_cents",
        "fee_cents",
        "timezone",
        "assessment_time",
        "description",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "business_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "balance_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "assessed_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "paid_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "outstanding_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        }
      },
      "required": [
        "id",
        "account_id",
        "rule_id",
        "business_date",
        "at",
        "balance_cents",
        "assessed_cents",
        "paid_cents",
        "outstanding_cents"
      ],
      "additionalProperties": false
    },
    "feed_error": {
      "type": "object",
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "interval": {
          "enum": [
            "1d",
            "15m"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "instrument_id",
        "interval",
        "message"
      ],
      "additionalProperties": false
    },
    "market_source": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "synthetic",
            "live",
            "replay"
          ]
        },
        "provider": {
          "enum": [
            "authored",
            "yahoo_chart",
            "alphavantage_demo"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable"
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/feed_error"
          }
        }
      },
      "required": [
        "mode",
        "provider",
        "status",
        "checked_at",
        "last_success_at",
        "snapshot_id",
        "errors"
      ],
      "additionalProperties": false
    },
    "market_snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "provider": {
          "enum": [
            "yahoo_chart",
            "alphavantage_demo"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable"
          ]
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "seed.schema.json#/$defs/instrument"
          }
        },
        "quotes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "seed.schema.json#/$defs/quote"
          }
        },
        "history": {
          "type": "array",
          "maxItems": 1440,
          "items": {
            "$ref": "seed.schema.json#/$defs/bar"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/feed_error"
          }
        }
      },
      "required": [
        "id",
        "provider",
        "checked_at",
        "status",
        "instruments",
        "quotes",
        "history",
        "errors"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "price_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "total_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        }
      },
      "required": [
        "account_id",
        "instrument_id",
        "quantity",
        "quote_id",
        "price_cents",
        "total_cents"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "proposal_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "type": "boolean"
        },
        "consumed": {
          "type": "boolean"
        },
        "revocation_source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "decision",
        "source_ref",
        "proposal_hash",
        "expires_at",
        "recorded_at",
        "revoked",
        "consumed"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "transfer",
            "buy",
            "sell"
          ]
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "seed.schema.json#/$defs/transfer"
            },
            {
              "$ref": "seed.schema.json#/$defs/order"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "instruction_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "account_revisions": {
          "type": "object",
