      "items": {
        "$ref": "seed.schema.json#/$defs/holding"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/proposal"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/receipt"
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/transaction"
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/instrument"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/quote"
      }
    },
    "market_history": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/bar"
      }
    },
    "announcements": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/announcement"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/obligation"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/rule"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/assessment"
      }
    },
    "market_source": {
      "$ref": "seed.schema.json#/$defs/market_source"
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "instruction",
    "next_id",
    "accounts",
    "holdings",
    "proposals",
    "receipts",
    "transactions",
    "instruments",
    "quotes",
    "market_history",
    "announcements",
    "obligations",
    "rules",
    "assessments"
