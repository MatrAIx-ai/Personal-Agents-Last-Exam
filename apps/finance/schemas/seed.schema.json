      "type": "object",
      "properties": {
        "from_account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "to_account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        }
      },
      "required": [
        "from_account",
        "to_account",
        "amount_cents"
      ],
      "additionalProperties": false
    },
    "order_input": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "account_id",
        "instrument_id",
        "quantity"
      ],
      "additionalProperties": false
    },
    "holding": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "cost_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        }
      },
      "required": [
        "account_id",
        "instrument_id",
        "quantity",
        "cost_cents"
      ],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
