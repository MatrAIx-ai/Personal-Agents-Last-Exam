  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "kind": {
          "enum": [
            "bank",
            "brokerage"
          ]
        },
        "owner_person_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "currency": {
          "const": "USD"
        },
        "balance_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "owner_person_id",
        "currency",
        "balance_cents",
        "revision"
      ],
      "additionalProperties": false
    },
    "instruction": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9000000000000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "revision",
        "text",
        "source_ref"
      ],
      "additionalProperties": false
    },
