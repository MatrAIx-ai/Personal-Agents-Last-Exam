      "required": [
        "id",
        "instrument_id",
        "text",
        "published_at",
        "available_at"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
