{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "sponsored": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "override": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "at",
                  "override"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "release_blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "unresolved_note",
                    "invalid_license",
                    "missing_guest_release"
                  ]
                },
                "target_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200
                }
              },
              "required": [
                "code",
                "target_id",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "track_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "active_cut": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "cuts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "timecode": {
                        "type": "string",
                        "pattern": "^[0-9]{2}:[0-5][0-9]$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "resolved_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "timecode",
                      "text",
                      "at",
                      "resolved_at"
                    ],
                    "additionalProperties": false
                  }
                },
                "thumbnails": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "keyframes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "active_thumbnail": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "asset_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "ctr": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "retention": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "asset_id",
                      "ctr",
                      "retention",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "notes",
                "thumbnails",
                "keyframes",
                "active_thumbnail",
                "results"
              ],
              "additionalProperties": false
            }
          },
          "guest_releases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "status": {
                        "enum": [
                          "signed",
                          "withdrawn"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "at",
                      "status",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "history"
              ],
              "additionalProperties": false
            }
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "intended_transition": {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "enum": [
                        "private",
                        "unlisted",
                        "public"
                      ]
                    },
                    "scheduled_at": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "visibility",
                    "scheduled_at"
                  ],
                  "additionalProperties": false
                },
                "blockers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "enum": [
                          "unresolved_note",
                          "invalid_license",
                          "missing_guest_release"
                        ]
                      },
                      "target_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2200
                      }
                    },
                    "required": [
                      "code",
                      "target_id",
                      "message"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "actor",
                "at",
                "reason",
                "intended_transition",
                "blockers"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "sponsored",
          "visibility",
          "published_at",
          "schedule",
          "release_blockers",
          "track_id",
          "active_cut",
          "cuts",
          "guest_releases",
          "overrides"
        ],
        "additionalProperties": false
      }
    },
    "library": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "bgm",
              "b_roll",
              "transcript"
            ]
          },
          "mood": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bpm": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "license_scope": {
            "enum": [
              "commercial_sponsored",
              "non_commercial_only"
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "visual_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": [
                    "active",
                    "revoked"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "at",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "mood",
          "bpm",
          "license_scope",
          "expires_at",
          "visual_tags",
          "history"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "timezone",
    "projects",
    "library"
  ],
  "additionalProperties": false
}
