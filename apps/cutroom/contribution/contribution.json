{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "cutroom",
  "app_categories": [
    "personal"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "cutroom.projects.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "cutroom.cuts.list_notes",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "cutroom.library.search",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.audit_clearance",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "cutroom.cuts.add_note",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.cuts.resolve_note",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.update_metadata",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.set_thumbnail",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.assign_track",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.set_visibility",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.schedule_release",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "cutroom.projects.override_release",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "Per-App lock and optimistic epoch/revision check",
    "commit_confirmation": "committed + epoch/revision; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "cutroom.cut.add_note",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "cutroom.license.revoke",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "cutroom.ab_test.update",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": null,
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [
    {
      "namespace": "cutroom.evaluation_dataset",
      "version": "1",
      "required": false,
      "data": {
        "description": "Delivery evaluation dataset, 2025-01-01 to 2026-12-31, fully synthetic. fixtures/minimal.json stays the default smoke seed.",
        "seed": "datasets/history/seed.json",
        "dataset": "datasets/history/dataset.json",
        "catalog": "datasets/history/assets.catalog.json",
        "binding": "datasets/history/binding.json",
        "load_seed_arguments": "scripts/history-bundle.cjs#loadSeedArgs",
        "default_virtual_now": "2026-11-19T18:00:00Z",
        "coverage_report": "evidence/coverage.md"
      }
    }
  ],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [
      "image/png"
    ],
    "implemented_storage_adapters": [
      "storage.file"
    ],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
