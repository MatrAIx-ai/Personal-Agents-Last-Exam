{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:trailhead-rec:events:1",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "waitlist.spot_opened"
        },
        "payload": {
          "type": "object",
          "properties": {
            "enrollment_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "offer_expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "enrollment_id",
            "offer_expires_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "facility.weather_closure"
        },
        "payload": {
          "type": "object",
          "properties": {
            "facility_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "closed_until": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "facility_id",
            "closed_until",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "member.waiver_status_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "person_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "waiver_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "status": {
              "enum": [
                "signed",
                "pending",
                "withdrawn"
              ]
            }
          },
          "required": [
            "person_ref",
            "waiver_type",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "program.schedule_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "program_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "new_time_slot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "penalty_free_until": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "program_id",
            "new_time_slot",
            "penalty_free_until"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
