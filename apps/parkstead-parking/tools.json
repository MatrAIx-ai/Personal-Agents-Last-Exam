    "description": "Record delivered, rejected, or unknown Mail acknowledgement.",
    "read_only": false,
    "scope": "parkstead-parking.parking.notification.email.record",
    "resource_target": "current authorized Parkstead account and referenced parking objects",
    "inputSchema": {
      "type": "object",
