          "type": "string",
          "format": "date-time"
        },
        "departure_at": {
          "type": "string",
          "format": "date-time"
        },
        "vehicle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        },
        "max_walk_meters": {
          "type": "integer",
          "minimum": 0
        },
        "covered": {
          "type": "boolean"
        },
        "accessible": {
          "type": "boolean"
        },
        "ev_charging": {
          "type": "boolean"
        },
        "in_out": {
          "type": "boolean"
        }
