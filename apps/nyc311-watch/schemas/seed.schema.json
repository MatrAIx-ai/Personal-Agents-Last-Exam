{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "borough": {
            "enum": [
              "BRONX",
              "BROOKLYN",
              "MANHATTAN",
              "QUEENS",
              "STATEN ISLAND"
            ]
          },
          "category": {
            "enum": [
              "Street Condition"
            ]
          },
          "source": {
            "enum": [
              "nyc311-snapshot",
              "synthetic-gaps",
              "smoke"
            ]
          },
          "recorded_closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": [
                    "open",
                    "in_progress",
                    "closed"
                  ]
                },
                "agency": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{1,16}$"
                },
                "source": {
                  "enum": [
                    "nyc311-snapshot",
                    "synthetic-gaps",
                    "smoke"
                  ]
                }
              },
              "required": [
                "at",
                "status",
                "agency",
                "source"
              ],
              "additionalProperties": false
            },
            "maxItems": 24
          }
        },
        "required": [
          "case_id",
          "created_at",
          "borough",
          "category",
          "source",
          "recorded_closed_at",
          "observations"
        ],
        "additionalProperties": false
      },
      "maxItems": 1200
    },
    "watches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "watch_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "change_types": {
            "type": "array",
            "items": {
              "enum": [
                "resolved",
                "reopened",
                "agency_changed",
                "admin_update"
              ]
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "watch_id",
          "account_id",
          "case_id",
          "change_types",
          "version",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 1200
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "watch_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "change_type": {
            "enum": [
              "resolved",
              "reopened",
              "agency_changed",
              "admin_update"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string",
            "maxLength": 160
          },
          "acknowledged_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "activity_id",
          "watch_id",
          "account_id",
          "case_id",
          "event_id",
          "change_type",
          "at",
          "message",
          "acknowledged_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "operation": {
                "const": "civic311.case_status_changed"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
                  },
                  "previous_status": {
                    "enum": [
                      "open",
                      "in_progress",
                      "closed"
                    ]
                  },
                  "new_status": {
                    "enum": [
                      "open",
                      "in_progress",
                      "closed"
                    ]
                  }
                },
                "required": [
                  "case_id",
                  "previous_status",
                  "new_status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "at",
              "operation",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "operation": {
                "const": "civic311.case_agency_changed"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
                  },
                  "previous_agency": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{1,16}$"
                  },
                  "new_agency": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{1,16}$"
                  }
                },
                "required": [
                  "case_id",
                  "previous_agency",
                  "new_agency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "at",
              "operation",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "operation": {
                "const": "civic311.case_admin_updated"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
                  },
                  "update_code": {
                    "enum": [
                      "inspection_logged",
                      "record_corrected"
                    ]
                  }
                },
                "required": [
                  "case_id",
                  "update_code"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "at",
              "operation",
              "payload"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 5000
    }
  },
  "required": [
    "account_id",
    "cases",
    "watches",
    "activity",
    "events"
  ],
  "additionalProperties": false
}
