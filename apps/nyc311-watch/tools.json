[
  {
    "name": "civic311.search_cases",
    "description": "Find visible street-condition cases by exact local ID, borough or current status; newest first.",
    "read_only": true,
    "scope": "civic311.search_cases",
    "resource_target": "bound sandbox resident account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
        },
        "borough": {
          "enum": [
            "BRONX",
            "BROOKLYN",
            "MANHATTAN",
            "QUEENS",
            "STATEN ISLAND"
          ]
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "closed",
            "unknown"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "civic311"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "borough": {
                "enum": [
                  "BRONX",
                  "BROOKLYN",
                  "MANHATTAN",
                  "QUEENS",
                  "STATEN ISLAND"
                ]
              },
              "category": {
                "enum": [
                  "Street Condition"
                ]
              },
              "status": {
                "enum": [
                  "open",
                  "in_progress",
                  "closed",
                  "unknown"
                ]
              },
              "agency": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{1,16}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "admin_update_code": {
                "anyOf": [
                  {
                    "enum": [
                      "inspection_logged",
                      "record_corrected"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_updated_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "case_id",
              "created_at",
              "borough",
              "category",
              "status",
              "agency",
              "admin_update_code",
              "last_updated_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "items",
        "total",
        "next_offset"
      ],
      "additionalProperties": false
    }
  },
