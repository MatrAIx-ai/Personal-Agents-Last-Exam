[
  {
    "name": "benchguide.catalog.search",
    "description": "Search lab-tested products by category, price, noise ceiling, required feature, pick status, and sort by overall or user-weighted score.",
    "read_only": true,
    "scope": "benchguide.catalog.search",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "air_purifier",
            "cordless_vacuum",
            "anc_headphones",
            "coffee_grinder"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "pick_status": {
          "enum": [
            "top_pick",
            "recommended",
            "budget_pick",
            "downgraded",
            "none"
          ]
        },
        "max_price_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_noise_db_high": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "require_feature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "exclude_dismissed": {
          "type": "boolean"
        },
        "sort_by": {
          "enum": [
            "overall",
            "weighted",
            "price_asc"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "benchguide"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "items"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "benchguide.review.get",
    "description": "Read a single product review including lab metrics, revision history, chart asset_ids, and MCP resource_uris.",
    "read_only": true,
    "scope": "benchguide.review.get",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "product_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "benchguide"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "product": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "category": {
              "enum": [
                "air_purifier",
                "cordless_vacuum",
                "anc_headphones",
                "coffee_grinder"
              ]
            },
            "price_usd": {
              "type": "number",
              "minimum": 0
            },
            "pick_status": {
              "enum": [
                "top_pick",
                "recommended",
                "budget_pick",
                "downgraded",
                "none"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "maxItems": 30,
              "uniqueItems": true
            },
            "metrics": {
              "type": "object",
              "properties": {
                "overall_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "performance_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "noise_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "reliability_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "value_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "measured_noise_db_high": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "overall_score",
                "performance_score",
                "noise_score",
                "reliability_score",
                "value_score",
                "measured_noise_db_high"
              ],
              "additionalProperties": false
            },
            "asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "maxItems": 16,
              "uniqueItems": true
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "revisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "revision_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "published_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "pick_status": {
                    "enum": [
                      "top_pick",
                      "recommended",
                      "budget_pick",
                      "downgraded",
                      "none"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  }
                },
                "required": [
                  "revision_id",
                  "published_at",
                  "pick_status",
                  "summary"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            }
          },
          "required": [
            "id",
            "name",
            "category",
            "price_usd",
            "pick_status",
            "summary",
            "features",
            "metrics",
            "asset_ids",
            "published_at",
            "updated_at",
            "revisions"
          ],
          "additionalProperties": false
        },
        "weighted_score": {
          "type": "number"
        },
        "resource_uris": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "product",
        "weighted_score",
        "resource_uris"
      ],
      "additionalProperties": false
    }
  },
