{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "enum": [
        "benchguide.review.revise",
        "benchguide.catalog.publish"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false
}
