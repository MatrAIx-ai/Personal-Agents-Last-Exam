                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                              },
                              "object_type": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80
                              },
                              "object_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              }
                            },
                            "required": [
                              "app_id",
                              "object_type",
                              "object_id"
                            ],
                            "additionalProperties": false,
                            "description": "The record the agent read these facts from. VisaSlot stores it for grading; it never reads that App."
                          }
                        },
                        "required": [
                          "enter_on",
                          "leave_on"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "invitation_letter",
                      "travel_signature",
                      "accommodation",
                      "travel"
                    ],
                    "additionalProperties": false
                  },
                  "locked_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Set when the appointment is held; a locked file cannot change."
                  }
                },
                "required": [
                  "version",
                  "submitted_at",
                  "documents",
                  "locked_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "file_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
