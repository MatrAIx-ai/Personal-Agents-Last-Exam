                            "pattern": "^[A-Z]{2}$",
                            "description": "ISO 3166-1 alpha-2 country code, e.g. DE or FR."
                          },
                          "check_in": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
