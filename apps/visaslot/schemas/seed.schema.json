                          },
                          "valid_until": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                            "description": "Lapse date, exclusive: the signature is valid before this date and lapsed on it. After signed_on."
                          }
                        },
                        "required": [
                          "source",
                          "signed_on",
                          "valid_until"
                        ],
                        "additionalProperties": false
                      },
                      "accommodation": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "country": {
                              "type": "string",
                              "pattern": "^[A-Z]{2}$",
