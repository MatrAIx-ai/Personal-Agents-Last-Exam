                            },
                            "source": {
                              "type": "object",
                              "properties": {
                                "app_id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                                },
                                "object_type": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 80
                                },
                                "object_id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                                }
                              },
                              "required": [
                                "app_id",
                                "object_type",
                                "object_id"
                              ],
                              "additionalProperties": false,
                              "description": "The record the agent read these facts from. VisaSlot stores it for grading; it never reads that App."
                            }
                          },
                          "required": [
                            "country",
                            "check_in",
                            "check_out",
                            "source"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 60,
                        "minItems": 1,
                        "description": "Stays in any order; no two stays may share a night."
                      },
                      "travel": {
                        "type": "object",
                        "properties": {
                          "enter_on": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
