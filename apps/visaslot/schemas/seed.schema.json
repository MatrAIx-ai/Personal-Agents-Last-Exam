{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:visaslot:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "passport_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Name as printed in the applicant's passport; the name-match rule compares the letter against it."
    },
    "consulates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code, e.g. DE or FR."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone; slot times carry its UTC offset and dates are local dates there."
          }
        },
        "required": [
          "id",
          "name",
          "country",
          "city",
          "timezone"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "minItems": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "consulate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "slot_at": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the slot, written with the consulate's local UTC offset."
          },
          "status": {
            "enum": [
              "open",
              "taken",
              "booked",
              "closed"
            ],
            "description": "open: bookable; taken: by another applicant; booked: by this applicant's appointment; closed: withdrawn by the consulate."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Increases each time the slot changes status."
          },
          "appointment_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "consulate_id",
          "slot_at",
          "status",
          "version",
          "appointment_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "appointments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "consulate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code, e.g. DE or FR."
          },
          "slot_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "booked",
              "cancelled",
              "held"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Increases on booking, reschedule, cancellation and hold. A file submission does not change it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": [
                    "booked",
                    "cancelled",
                    "held"
                  ]
                },
                "slot_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The slot the appointment held after this step."
                },
                "action": {
                  "enum": [
                    "booked",
                    "rescheduled",
                    "cancelled",
                    "cancelled_by_consulate",
                    "held"
                  ]
                }
              },
              "required": [
                "at",
                "status",
                "slot_at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 200,
            "minItems": 1,
            "description": "Every booking, reschedule, cancellation and hold, with the slot held after it."
          },
          "cancellation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "by": {
                    "enum": [
                      "applicant",
                      "consulate"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "by",
                  "at",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "submitted_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "documents": {
                    "type": "object",
                    "properties": {
                      "invitation_letter": {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "object",
                            "properties": {
                              "app_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                              },
                              "object_type": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80
                              },
                              "object_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              }
                            },
                            "required": [
                              "app_id",
                              "object_type",
                              "object_id"
                            ],
                            "additionalProperties": false,
                            "description": "The record the agent read these facts from. VisaSlot stores it for grading; it never reads that App."
                          },
                          "name_on_letter": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "issued_on": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                            "description": "Date the letter was issued. Must not be after the submission date at the consulate."
                          }
                        },
                        "required": [
                          "source",
                          "name_on_letter",
                          "issued_on"
                        ],
                        "additionalProperties": false
                      },
                      "travel_signature": {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "object",
                            "properties": {
                              "app_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                              },
                              "object_type": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80
                              },
                              "object_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              }
                            },
                            "required": [
                              "app_id",
                              "object_type",
                              "object_id"
                            ],
                            "additionalProperties": false,
                            "description": "The record the agent read these facts from. VisaSlot stores it for grading; it never reads that App."
                          },
                          "signed_on": {
