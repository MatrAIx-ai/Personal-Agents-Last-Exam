                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                            "description": "After check_in. Nights are check_in up to the day before check_out."
                          },
                          "source": {
                            "type": "object",
                            "properties": {
                              "app_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                              },
                              "object_type": {
                                "type": "string",
                                "minLength": 1,
