{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
    },
    "merchant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "id",
        "version",
        "summary"
      ],
      "additionalProperties": false
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "item_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "policy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "ordered_at": {
            "type": "string",
            "format": "date-time"
          },
          "return_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "refund_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "refundable": {
            "type": "boolean"
          },
          "order_number": {
            "type": "string",
            "pattern": "^[0-9]{5,12}$"
          }
        },
        "required": [
          "id",
          "item_id",
          "item_name",
          "policy_id",
          "ordered_at",
          "return_deadline",
          "refund_minor",
          "currency",
          "refundable"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "order_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "discarded",
              "confirmed",
              "cancelled",
              "dispatched"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "order_id",
          "status",
          "created_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "account_id",
    "merchant",
    "policy",
    "orders",
    "requests"
  ],
  "additionalProperties": false
}
