  {
    "name": "refund-only-returns.lookup_order",
    "description": "Look up a synthetic order by stable ID or order number, with or without the leading #.",
    "read_only": true,
    "scope": "refund-only-returns.lookup_order",
    "resource_target": "bound synthetic shopper account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][-A-Za-z0-9_]{0,79}|#[0-9]{5,12})$",
          "description": "Exact stable order ID or the order number shown to the shopper; a leading # is optional for a numeric order number."
        }
      },
      "required": [
        "order_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "app_id": {
          "type": "string",
          "enum": [
            "refund-only-returns"
          ]
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "virtual_now": {
          "type": "string",
          "format": "date-time"
        },
        "order": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
            },
            "item_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
            },
            "item_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "policy_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]{0,79}$"
            },
            "ordered_at": {
              "type": "string",
              "format": "date-time"
            },
            "return_deadline": {
              "type": "string",
              "format": "date-time"
            },
            "refund_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "currency": {
              "type": "string",
              "enum": [
                "CNY"
              ]
            },
            "refundable": {
              "type": "boolean"
            },
            "deadline_passed": {
              "type": "boolean"
            },
            "eligibility": {
              "type": "string",
              "enum": [
                "eligible",
                "expired",
                "ineligible",
                "already_requested"
              ]
            },
            "order_number": {
              "type": "string",
              "pattern": "^[0-9]{5,12}$"
            }
          },
          "required": [
            "id",
            "item_id",
            "item_name",
            "policy_id",
            "ordered_at",
            "return_deadline",
            "refund_minor",
            "currency",
            "refundable",
            "deadline_passed",
            "eligibility"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "virtual_now",
        "order"
      ],
      "additionalProperties": false
    }
  },
