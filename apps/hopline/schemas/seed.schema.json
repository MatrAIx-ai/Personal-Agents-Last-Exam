{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:hopline:seed:1",
  "title": "Hopline account and network data",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
    },
    "settings": {
      "type": "object",
      "properties": {
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "time_zone"
      ],
      "additionalProperties": false
    },
    "rider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "payment_methods": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/payment_method"
          },
          "maxItems": 10
        }
      },
      "required": [
        "name",
        "payment_methods"
      ],
      "additionalProperties": false
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/stop"
      },
      "maxItems": 500
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/node"
      },
      "maxItems": 2000
    },
    "pathways": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/pathway"
      },
      "maxItems": 2000
    },
    "facilities": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/facility"
      },
      "maxItems": 500
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/route"
      },
      "maxItems": 100
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/pattern"
      },
      "maxItems": 400
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/place"
      },
      "maxItems": 500
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/alert"
      },
      "maxItems": 1000
    },
    "trip_updates": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/trip_update"
      },
      "maxItems": 5000
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/card"
      },
      "maxItems": 50
    },
    "ledger": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/ledger_entry"
      },
      "maxItems": 10000
    },
    "taps": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/tap"
      },
      "maxItems": 10000
    },
    "passes": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/pass"
      },
      "maxItems": 200
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/application"
      },
      "maxItems": 100
    },
    "saved": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/saved"
      },
      "maxItems": 20
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/subscription"
      },
      "maxItems": 200
    },
    "notifications": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/notification"
      },
      "maxItems": 20000
    },
    "ignored_events": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/event_record"
      },
      "maxItems": 5000
    },
    "redirects": {
      "type": "array",
      "items": {
        "$ref": "seed.schema.json#/$defs/redirect"
      },
      "maxItems": 5000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "settings",
    "rider",
    "stops",
    "nodes",
    "pathways",
    "facilities",
    "routes",
    "patterns",
    "places",
    "alerts",
    "trip_updates",
    "cards",
    "ledger",
    "taps",
    "passes",
    "applications",
    "saved",
    "subscriptions",
    "notifications",
    "ignored_events",
    "redirects"
  ],
  "additionalProperties": false,
  "$defs": {
    "external_ref": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        }
      },
      "required": [
        "app_id",
        "account_id",
        "object_id"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "stop_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "station",
            "stop"
          ]
        },
        "step_free": {
          "type": "boolean"
        },
        "external_ref": {
          "anyOf": [
            {
              "$ref": "seed.schema.json#/$defs/external_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stop_id",
        "name",
        "kind",
        "step_free",
        "external_ref"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "stop_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "kind": {
          "enum": [
            "entrance",
            "platform",
            "bus_bay",
            "stop"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "node_id",
        "stop_id",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "pathway": {
      "type": "object",
      "properties": {
        "pathway_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "mode": {
          "enum": [
            "walkway",
            "stairs",
            "escalator",
            "elevator",
            "ramp"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "length_m": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "bidirectional": {
          "type": "boolean"
        },
        "facility_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pathway_id",
        "from",
        "to",
        "mode",
        "seconds",
        "length_m",
        "bidirectional",
        "facility_id"
      ],
      "additionalProperties": false
    },
    "facility_status": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "status": {
          "enum": [
            "out_of_service",
            "in_service"
          ]
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "expected_return": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "seq",
        "status",
        "since",
        "expected_return",
        "note",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "facility": {
      "type": "object",
      "properties": {
        "facility_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "kind": {
          "enum": [
            "elevator",
            "escalator",
            "ramp"
          ]
        },
        "stop_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pathway_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
          },
          "maxItems": 10
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/facility_status"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "facility_id",
        "code",
        "kind",
        "stop_id",
        "name",
        "pathway_ids",
        "history"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "short_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "rail",
            "bus"
          ]
        }
      },
      "required": [
        "route_id",
        "short_name",
        "name",
        "mode"
      ],
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "direction": {
          "enum": [
            "nb",
            "sb"
          ]
        },
        "headsign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
              },
              "offset_min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "node_id",
              "offset_min"
            ],
            "additionalProperties": false
          },
          "maxItems": 100,
          "minItems": 2
        },
        "frequencies": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "headway_min": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240
                  }
                },
                "required": [
                  "start",
                  "end",
                  "headway_min"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "saturday": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "headway_min": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240
                  }
                },
                "required": [
                  "start",
                  "end",
                  "headway_min"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "sunday": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "headway_min": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240
                  }
                },
                "required": [
                  "start",
                  "end",
                  "headway_min"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            }
          },
          "required": [
            "weekday",
            "saturday",
            "sunday"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pattern_id",
        "route_id",
        "direction",
        "headsign",
        "stops",
        "frequencies"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "length_m": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "step_free": {
          "type": "boolean"
        }
      },
      "required": [
        "node_id",
        "seconds",
        "length_m",
        "step_free"
      ],
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "place_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "address",
            "landmark"
          ]
        },
        "access": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/access"
          },
          "maxItems": 10,
          "minItems": 1
        }
      },
      "required": [
        "place_id",
        "name",
        "kind",
        "access"
      ],
      "additionalProperties": false
    },
    "alert_version": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "msg_type": {
          "enum": [
            "alert",
            "update",
            "cancel"
          ]
        },
        "cause": {
          "enum": [
            "construction",
            "maintenance",
            "accident",
            "weather",
            "technical_problem",
            "police_activity",
            "special_event",
            "other"
          ]
        },
        "effect": {
          "enum": [
            "detour",
            "stop_closed",
            "no_service",
            "reduced_service",
            "significant_delays",
            "stop_moved"
          ]
        },
        "informed": {
          "type": "object",
          "properties": {
            "route_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
              },
              "maxItems": 50
            },
            "stop_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
              },
              "maxItems": 200
            },
            "facility_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
              },
              "maxItems": 100
            }
          },
          "required": [
            "route_ids",
            "stop_ids",
            "facility_ids"
          ],
          "additionalProperties": false
        },
        "replacement_stop_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "maxItems": 20,
          "minItems": 1
        },
        "header": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "version",
        "msg_type",
        "cause",
        "effect",
        "informed",
        "replacement_stop_id",
        "active_periods",
        "header",
        "description",
        "issued_at"
      ],
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "seed.schema.json#/$defs/alert_version"
          },
          "maxItems": 1000,
          "minItems": 1
        }
      },
      "required": [
        "alert_id",
        "versions"
      ],
      "additionalProperties": false
    },
    "trip_update": {
      "type": "object",
      "properties": {
        "trip_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "delay_min": {
          "type": "integer",
          "minimum": -60,
          "maximum": 600
        },
        "cancelled": {
          "type": "boolean"
        },
        "skipped_stop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "trip_id",
        "seq",
        "at",
        "delay_min",
        "cancelled",
        "skipped_stop_ids"
      ],
      "additionalProperties": false
    },
    "payment_method": {
      "type": "object",
      "properties": {
        "payment_method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "last4": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "fails": {
          "type": "boolean"
        }
      },
      "required": [
        "payment_method_id",
        "label",
        "last4",
        "fails"
      ],
      "additionalProperties": false
    },
    "autoreload": {
      "type": "object",
      "properties": {
        "threshold_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 500,
          "maximum": 50000
        },
        "payment_method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:~-]{0,149}$"
        }
      },
      "required": [
        "threshold_cents",
        "amount_cents",
        "payment_method_id"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "card_id": {
