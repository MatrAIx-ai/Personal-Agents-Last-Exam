{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plateway incoming events",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "restaurant.status_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "restaurant_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "status": {
              "enum": [
                "open",
                "paused"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "restaurant_id",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "menu_item.availability_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "available": {
              "type": "boolean"
            }
          },
          "required": [
            "item_id",
            "available"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "menu_item.price_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "price_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "item_id",
            "price_cents"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
