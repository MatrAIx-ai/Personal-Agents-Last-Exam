      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "plateway.account.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.restaurants.search",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.restaurants.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.menu_items.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.cart.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.cart.add_item",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.cart.update_item",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.cart.remove_item",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.checkout.preview",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.place",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.cancel.preview",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.cancel.confirm",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.report_issue",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "plateway.orders.rate",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
