[
  {
    "name": "passage.travel_signature.request",
    "description": "Submit the ISSO \"Travel Signature Request\" e-form for the student's I-20. It is processed on the Nth business day after today's office date (rules.processing_business_days; weekends and office holidays do not count); due_on gives that date. The office emails a receipt and, once processed, the signed I-20. While a request is still being processed, submitting again returns that request with created=false and changes nothing.",
    "read_only": false,
    "scope": "passage.travel_signature.request",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "expected_version",
        "request_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "committed"
        },
        "app_id": {
          "const": "passage"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^req-[0-9]{4,8}$"
            },
            "kind": {
              "const": "travel_signature"
            },
            "document_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "submitted_at": {
              "type": "string",
              "format": "date-time"
            },
            "submitted_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Office date of submitted_at; day 0 of the business-day count."
            },
            "business_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "The processing rule in force when the request was submitted."
            },
            "due_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "The business_days-th business day after submitted_on (weekends and listed holidays skipped). Processing is not accepted before this date."
            },
            "status": {
              "enum": [
                "submitted",
                "processed"
              ]
            },
            "processed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "processed_event_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "signature_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sig-[0-9]{4,8}$",
                  "description": "Shares the number of the request that produced it (req-0142 → sig-0142)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "at",
                  "action"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            }
          },
          "required": [
            "id",
            "kind",
            "document_id",
            "submitted_at",
            "submitted_on",
            "business_days",
            "due_on",
            "status",
            "processed_at",
            "processed_event_id",
            "signature_id",
            "created_at",
            "updated_at",
            "history"
          ],
          "additionalProperties": false
        },
        "created": {
          "type": "boolean"
        },
        "notice_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "request",
        "created",
        "notice_id"
      ],
      "additionalProperties": false
    }
  },
