  {
    "name": "passage.documents.status",
    "description": "Read the student's I-20 and its travel signatures: signing date, valid_until (the lapse date), and whether each is valid or lapsed today in the office time zone, plus any request still being processed. Reading changes nothing.",
    "read_only": true,
    "scope": "passage.documents.status",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "passage"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "today": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date YYYY-MM-DD in the office's time zone."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "kind": {
                "const": "i20"
              },
              "holder_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "school": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "travel_signature_status": {
                "enum": [
                  "valid",
                  "lapsed",
                  "none"
                ],
                "description": "Status of current_signature today in the office time zone."
              },
              "current_signature": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^sig-[0-9]{4,8}$",
                        "description": "Shares the number of the request that produced it (req-0142 → sig-0142)."
                      },
                      "request_id": {
                        "type": "string",
                        "pattern": "^req-[0-9]{4,8}$"
                      },
                      "document_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "issued_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the signed I-20 reached the student (the processing event time)."
                      },
                      "signed_on": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "description": "Office date of issued_at."
                      },
                      "valid_until": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "description": "Lapse date: the signature is valid on dates before valid_until and lapsed from 00:00 office time on valid_until."
                      },
                      "status": {
                        "enum": [
                          "valid",
                          "lapsed"
                        ]
                      },
                      "days_until_lapse": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000,
                        "description": "Days from today to valid_until; 0 once lapsed."
                      }
                    },
                    "required": [
                      "id",
                      "request_id",
                      "document_id",
                      "issued_at",
                      "signed_on",
                      "valid_until",
                      "status",
                      "days_until_lapse"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The most recently issued travel signature."
              },
              "signatures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^sig-[0-9]{4,8}$",
                      "description": "Shares the number of the request that produced it (req-0142 → sig-0142)."
                    },
                    "request_id": {
                      "type": "string",
                      "pattern": "^req-[0-9]{4,8}$"
                    },
                    "document_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "issued_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the signed I-20 reached the student (the processing event time)."
                    },
                    "signed_on": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                      "description": "Office date of issued_at."
                    },
                    "valid_until": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                      "description": "Lapse date: the signature is valid on dates before valid_until and lapsed from 00:00 office time on valid_until."
                    },
                    "status": {
                      "enum": [
                        "valid",
                        "lapsed"
                      ]
                    },
                    "days_until_lapse": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000,
                      "description": "Days from today to valid_until; 0 once lapsed."
                    }
                  },
                  "required": [
                    "id",
                    "request_id",
                    "document_id",
                    "issued_at",
                    "signed_on",
                    "valid_until",
                    "status",
                    "days_until_lapse"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 500
              },
              "pending_request_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^req-[0-9]{4,8}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "holder_name",
              "school",
              "travel_signature_status",
              "current_signature",
              "signatures",
              "pending_request_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 1
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "as_of",
        "today",
        "timezone",
        "documents"
      ],
      "additionalProperties": false
    }
  }
]
