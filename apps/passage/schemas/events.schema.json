{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:passage:events:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "passage.request.processed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^req-[0-9]{4,8}$"
            },
            "submitted_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Calendar date YYYY-MM-DD in the office's time zone."
            },
            "business_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "counted_days": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Calendar date YYYY-MM-DD in the office's time zone."
              },
              "minItems": 1,
              "maxItems": 30,
              "description": "The business days counted, in order, after submitted_on."
            },
            "skipped_holidays": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "description": "Calendar date YYYY-MM-DD in the office's time zone."
              },
              "maxItems": 60,
              "description": "Weekday holidays skipped between submitted_on and due_on."
            },
            "due_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Calendar date YYYY-MM-DD in the office's time zone."
            }
          },
          "required": [
            "request_id",
            "submitted_on",
            "business_days",
            "counted_days",
            "skipped_holidays",
            "due_on"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
