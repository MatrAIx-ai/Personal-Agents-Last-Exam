{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:passage:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "mail_account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "office": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone of the office; business days, signing dates and lapse dates are dates there."
        }
      },
      "required": [
        "name",
        "timezone"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "processing_business_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "A travel-signature request is processed on the Nth business day after the date it was submitted."
        },
        "signature_validity_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "valid_until is signed_on plus this many calendar months (day clamped to the month end)."
        }
      },
      "required": [
        "processing_business_days",
        "signature_validity_months"
      ],
      "additionalProperties": false
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date YYYY-MM-DD in the office's time zone."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "date",
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 400,
      "description": "Optional office closure dates that are not business days. Absent: the built-in default table (2026-2028). An empty array: Monday to Friday with no holidays."
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "const": "i20"
          },
          "holder_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "school": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "id",
          "kind",
          "holder_name",
          "school"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^req-[0-9]{4,8}$"
          },
          "kind": {
            "const": "travel_signature"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "submitted_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Office date of submitted_at; day 0 of the business-day count."
          },
          "business_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "The processing rule in force when the request was submitted."
          },
          "due_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "The business_days-th business day after submitted_on (weekends and listed holidays skipped). Processing is not accepted before this date."
          },
          "status": {
            "enum": [
              "submitted",
              "processed"
            ]
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "processed_event_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "signature_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sig-[0-9]{4,8}$",
                "description": "Shares the number of the request that produced it (req-0142 → sig-0142)."
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "document_id",
          "submitted_at",
          "submitted_on",
          "business_days",
          "due_on",
          "status",
          "processed_at",
          "processed_event_id",
          "signature_id",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sig-[0-9]{4,8}$",
            "description": "Shares the number of the request that produced it (req-0142 → sig-0142)."
          },
          "request_id": {
            "type": "string",
            "pattern": "^req-[0-9]{4,8}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the signed I-20 reached the student (the processing event time)."
          },
          "signed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Office date of issued_at."
          },
          "valid_until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Lapse date: the signature is valid on dates before valid_until and lapsed from 00:00 office time on valid_until."
          }
        },
        "required": [
          "id",
          "request_id",
          "document_id",
          "issued_at",
          "signed_on",
          "valid_until"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "enum": [
              "request_received",
              "signature_issued"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "ref": {
            "type": "object",
            "properties": {
              "object_type": {
                "enum": [
                  "travel_signature_request",
                  "travel_signature"
                ]
              },
              "object_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              }
            },
            "required": [
              "object_type",
              "object_id"
            ],
            "additionalProperties": false
          },
          "message": {
            "anyOf": [
              {
                "$id": "urn:pale:email-message:2",
                "title": "CloudEvents 1.0 + Mail Email payload v1",
                "description": "Generated from the PALE CloudEvents JSON profile and Mail-owned email-payload.schema.json. Do not hand-edit copies.",
                "type": "object",
                "properties": {
                  "specversion": {
                    "const": "1.0"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                    "maxLength": 512
                  },
                  "type": {
                    "const": "org.pale.mail.notification.v1"
                  },
                  "time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "datacontenttype": {
                    "const": "application/json"
                  },
                  "dataschema": {
                    "const": "urn:pale:email-payload:1"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "channel": {
                        "const": "channel.email"
                      },
                      "recipient": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "enum": [
                              "person_ref",
                              "app_account_ref",
                              "device_ref"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                          },
                          "app_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$",
                            "description": "Required by PALE validation when kind is app_account_ref."
                          }
                        },
                        "required": [
                          "kind",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      "source_object": {
                        "type": "object",
                        "properties": {
                          "app_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                          },
                          "account_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                          },
                          "object_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "object_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                          }
                        },
                        "required": [
                          "app_id",
                          "object_type",
                          "object_id",
                          "account_id"
                        ],
                        "additionalProperties": false
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "body": {
                            "type": "object",
                            "properties": {
                              "format": {
                                "const": "text/plain"
                              },
                              "text": {
                                "type": "string",
                                "maxLength": 20000
                              }
                            },
                            "required": [
                              "format",
                              "text"
                            ],
                            "additionalProperties": false
                          },
                          "asset_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                            },
                            "uniqueItems": true,
                            "maxItems": 0
                          },
                          "template_ref": {
                            "type": "string",
                            "minLength": 1
                          },
                          "deep_link": {
                            "type": "object",
                            "properties": {
                              "app_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              },
                              "route_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              },
                              "object_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                              }
                            },
                            "required": [
                              "app_id",
                              "route_id"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "title",
                          "body",
                          "asset_ids"
                        ],
                        "additionalProperties": false
                      },
                      "subscription_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "extensions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "namespace": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "data": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "namespace",
                            "version",
                            "required",
                            "data"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "channel",
                      "recipient",
                      "source_object",
                      "content",
                      "extensions"
                    ],
                    "additionalProperties": false,
                    "$id": "urn:pale:email-payload:1",
                    "title": "Mail-owned Email notification payload",
                    "description": "Business data only. Maintained by Mail; publisher packages consume a pinned copy."
                  }
                },
                "required": [
                  "specversion",
                  "id",
                  "source",
                  "type",
                  "datacontenttype",
                  "dataschema",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The Mail CloudEvent built when the notice was written, or null when the account has no Mail account. Infra reads it from env.snapshot and publishes it with router.publish."
          }
        },
        "required": [
          "id",
          "kind",
          "created_at",
          "title",
          "body",
          "ref",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "mail_account_id",
    "office",
    "rules",
    "documents",
    "requests",
    "signatures",
    "notices"
  ],
  "additionalProperties": false
}
