{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:recallwatch:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "recalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "product_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "upc": {
            "type": "string",
            "pattern": "^[0-9]{8,14}$"
          },
          "category": {
            "enum": [
              "snacks_groceries",
              "baby_gear",
              "otc_medicine",
              "small_appliances",
              "pet_food",
              "toys"
            ]
          },
          "severity": {
            "enum": [
              "class_i",
              "class_ii",
              "class_iii"
            ]
          },
          "hazard": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "active",
              "expanded",
              "amended",
              "closed"
            ]
          },
          "affected_lots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 200
          },
          "excluded_lots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 200
          },
          "remedy_types": {
            "type": "array",
            "items": {
              "enum": [
                "refund",
                "replacement",
                "repair_kit"
              ]
            },
            "minItems": 1,
            "maxItems": 3
          },
          "proof_required": {
            "type": "boolean"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "remedy_deadline_at": {
            "type": "string",
            "format": "date-time"
          },
          "label_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "brand",
          "product_name",
          "upc",
          "category",
          "severity",
          "hazard",
          "summary",
          "status",
          "affected_lots",
          "excluded_lots",
          "remedy_types",
          "proof_required",
          "published_at",
          "updated_at",
          "remedy_deadline_at",
          "label_asset_id",
          "history"
