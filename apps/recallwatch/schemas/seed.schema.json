          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "recall_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "lot_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "remedy_type": {
            "enum": [
              "refund",
              "replacement",
              "repair_kit"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "submitted",
              "under_review",
              "approved_refund",
              "approved_replacement",
              "approved_repair_kit",
              "rejected",
              "withdrawn"
            ]
          },
          "proof_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "file_ref",
                      "asset_ref",
                      "receipt_ref"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "recipient_person_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 160
          },
          "shipping_address": {
            "type": "string",
            "maxLength": 400
          },
          "payout_method": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "claim_receipt_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
