                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "account_id",
          "recall_id",
          "item_id",
          "lot_code",
          "remedy_type",
          "status",
          "proof_ref",
          "recipient_person_ref",
          "recipient_name",
          "shipping_address",
          "payout_method",
          "notes",
          "claim_receipt_id",
          "decision_amount_cents",
          "decision_note",
          "created_at",
          "updated_at",
          "submitted_at",
          "history"
        ],
        "additionalProperties": false
