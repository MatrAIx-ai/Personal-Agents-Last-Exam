        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "product_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "upc": {
            "type": "string",
            "pattern": "^[0-9]{8,14}$"
          },
          "category": {
            "enum": [
              "snacks_groceries",
              "baby_gear",
              "otc_medicine",
              "small_appliances",
              "pet_food",
              "toys"
