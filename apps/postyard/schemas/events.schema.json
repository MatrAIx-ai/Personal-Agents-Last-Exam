{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "at", "operation", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"},
    "at": {"type": "string", "format": "date-time"},
    "operation": {"type": "string"},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {
        "operation": {"const": "publication.release_due"},
        "payload": {"type": "object", "additionalProperties": false, "properties": {}}
      }
    },
    {
      "properties": {
        "operation": {"const": "owner.confirm_publication"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_type"],
          "properties": {
            "object_type": {"type": "string", "enum": ["post", "note", "profile"]},
            "object_id": {"type": "string"},
            "revision": {"type": "integer", "minimum": 1},
            "select": {"const": "only_pending"}
          }
        }
      }
    },
    {
      "properties": {
        "operation": {"const": "owner.decline_publication"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_type"],
          "properties": {
            "object_type": {"type": "string", "enum": ["post", "note", "profile"]},
            "object_id": {"type": "string"},
            "revision": {"type": "integer", "minimum": 1},
            "select": {"const": "only_pending"},
            "note": {"type": "string", "maxLength": 500}
          }
        }
      }
    },
    {
      "properties": {
        "operation": {"const": "notes.post_by_other"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_account_id", "text"],
          "properties": {
            "actor_account_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"},
            "text": {"type": "string", "minLength": 1, "maxLength": 800},
            "mentions": {"type": "array", "items": {"type": "string"}},
            "links": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  ]
}
