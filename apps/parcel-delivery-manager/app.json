{
  "schema_version": 1,
  "app_id": "parcel-delivery-manager",
  "version": "0.1.0",
  "core_api_version": "1.2.0",
  "maintainer": {
    "contact": "Linqiang Guo (@pockyitachi); repository issue / PR tagged app:parcel-delivery-manager"
  },
  "license": "MIT",
  "entrypoint": "plugin.cjs",
  "service": "service.cjs",
  "tools": "tools.json",
  "schemas": {
    "seed": "schemas/seed.schema.json",
    "state": "schemas/state.schema.json",
    "events": "schemas/events.schema.json"
  },
  "fixtures": {
    "seed": "fixtures/minimal.json",
    "binding": "fixtures/binding.json",
    "policies": "fixtures/policies.json"
  },
  "dependencies": [],
  "event_types": [
    "parcel.change_resolved",
    "parcel.transit_update",
    "parcel.delivery_failed",
    "parcel.delivered",
    "parcel.pickup_ready",
    "parcel.point_status",
    "parcel.carrier_relocated",
    "parcel.collected",
    "parcel.deadline_reached",
    "parcel.return_completed"
  ],
  "capabilities": {
    "modes": [
      "synthetic"
    ],
    "resources": false,
    "ui": "none",
    "real_delivery": false
