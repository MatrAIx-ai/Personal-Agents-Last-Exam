  {
    "name": "waypoint.transfers.get",
    "description": "Read one transfer or combine, including its delivery receipt or rejection.",
    "read_only": true,
    "scope": "waypoint.transfers.get",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "waypoint"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "item": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "kind": {
              "enum": [
                "partner_transfer",
                "household_combine"
              ]
            },
            "partner_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to_person_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipient": {
              "type": "object",
              "properties": {
                "app_id": {
                  "enum": [
                    "waypoint",
                    "skyline",
                    "harbor"
                  ]
                },
                "account_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                }
              },
              "required": [
                "app_id",
                "account_id"
              ],
              "additionalProperties": false
            },
            "member_number": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "ratio": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "to": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "description": "The partner ratio when the transfer was made."
            },
            "base_points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "bonus_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "status": {
              "enum": [
                "pending",
                "completed",
                "rejected"
              ]
            },
            "available_at": {
              "type": "string",
              "format": "date-time"
            },
            "debit_ledger_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "refund_ledger_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "receipt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                    },
                    "target_app_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                    },
                    "target_account_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                    }
                  },
                  "required": [
                    "event_id",
                    "target_app_id",
                    "target_account_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "rejection": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "code",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "settled_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "at",
                  "action"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            }
          },
          "required": [
            "id",
            "kind",
            "partner_id",
            "to_person_id",
            "recipient",
            "member_number",
            "ratio",
            "base_points",
            "bonus_pct",
            "points",
            "status",
            "available_at",
            "debit_ledger_id",
            "refund_ledger_id",
            "receipt",
            "rejection",
            "settled_at",
            "created_at",
            "updated_at",
            "history"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "item"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "waypoint.transfer.outbound",
    "description": "Build the stable loyalty-credit message for a transfer that is due for delivery. Reading changes nothing; delivery happens only when the host publishes it through Messaging and records the outcome.",
    "read_only": true,
    "scope": "waypoint.transfer.outbound",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "waypoint"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "message"
      ],
      "additionalProperties": false
    }
  }
]
