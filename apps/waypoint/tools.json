[
  {
    "name": "waypoint.balance",
    "description": "Read this member's points balance, the points held in pending transfers, the household members and the full points ledger.",
    "read_only": true,
    "scope": "waypoint.balance",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "waypoint"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "member_person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "balance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "pending_points": {
          "type": "integer",
          "minimum": 0
        },
        "household": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "waypoint_account_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              }
            },
            "required": [
              "person_id",
              "name",
              "waypoint_account_id"
            ],
            "additionalProperties": false
          }
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "kind": {
                "enum": [
                  "opening",
                  "earn",
                  "transfer_out",
                  "combine_out",
                  "combine_in",
                  "refund",
                  "adjustment"
                ]
              },
              "points": {
                "type": "integer",
                "minimum": -10000000,
                "maximum": 100000000
              },
              "balance_after": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 200
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "transfer",
                          "combine",
                          "message"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                      },
                      "app_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                      },
                      "account_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                      },
                      "message_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 150
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sent_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "at",
              "kind",
              "points",
              "balance_after",
              "description",
              "ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "member_person_id",
        "balance",
        "pending_points",
        "household",
        "ledger"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "waypoint.partners",
    "description": "List transfer partners: ratio, increment, minimum, whether the transfer is instant or delayed, the member's partner account, and any bonus active right now.",
    "read_only": true,
    "scope": "waypoint.partners",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "app_id": {
          "const": "waypoint"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "app_id": {
                "enum": [
                  "skyline",
                  "harbor"
                ]
              },
              "recipient_account_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$",
                "description": "The member's own account in the partner App; credits are routed only there."
              },
              "member_number": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ratio": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "increment": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "minimum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "delay_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20160,
                "description": "0 for an instant transfer; otherwise the credit is released this long after the transfer."
              },
              "bonus_pct_now": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "active_bonus_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "app_id",
              "recipient_account_id",
              "member_number",
              "ratio",
              "increment",
              "minimum",
              "delay_minutes",
              "bonus_pct_now",
              "active_bonus_id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "items"
      ],
      "additionalProperties": false
    }
  },
