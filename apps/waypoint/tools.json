  {
    "name": "waypoint.transfer",
    "description": "Transfer points to this member's own account in a partner program. Points must be a multiple of the partner increment and at least its minimum. Irreversible: there is no cancel. Points leave the balance now; the partner is credited when the transfer is delivered (instantly, or after the partner's delay).",
    "read_only": false,
    "scope": "waypoint.transfer",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "partner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "expected_version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "partner_id",
        "points",
        "expected_version",
        "request_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "committed"
        },
        "app_id": {
          "const": "waypoint"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "transfer_status": {
          "enum": [
            "pending",
            "completed",
            "rejected"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "bonus_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
