              "car_wash",
              "convenience_store",
              "accessible",
              "truck_access"
            ]
          }
        },
        "freshness_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "sort": {
          "enum": [
            "price",
            "distance",
            "trip_cost"
          ]
        }
