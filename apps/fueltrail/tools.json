              "type": "null"
            }
          ]
        },
        "grade": {
          "enum": [
            "regular",
            "midgrade",
            "premium",
            "diesel",
            "e85",
            "unleaded88"
          ]
        },
        "price_type": {
          "enum": [
            "cash",
            "credit"
          ]
        },
        "radius_milli": {
          "type": "integer"
        },
        "freshness_hours": {
