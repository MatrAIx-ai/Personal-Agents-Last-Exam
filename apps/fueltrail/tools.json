  {
    "name": "fueltrail.station.search",
    "description": "Search synthetic stations with explicit price freshness, distance, vehicle compatibility and deterministic sorting.",
    "read_only": true,
    "scope": "fueltrail.station.search",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "place_id": {
          "$ref": "schemas/domain.schema.json#/$defs/id"
