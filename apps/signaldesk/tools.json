            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "action": {
          "enum": [
            "change_plan",
            "cancel_plan",
            "buy_pass",
            "reschedule_pass",
            "cancel_pass"
          ]
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "line_id": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "expected_version",
        "request_id",
        "action"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "committed"
        },
        "app_id": {
          "const": "signaldesk"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "details"
      ],
      "additionalProperties": false
    }
