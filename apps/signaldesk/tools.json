  {
    "name": "signaldesk.preview",
    "description": "Preview a household plan change or a line-specific pass purchase, reschedule or cancellation.",
    "read_only": false,
    "scope": "signaldesk.preview",
    "resource_target": "bound household",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "object",
