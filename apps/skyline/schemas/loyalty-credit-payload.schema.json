{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:loyalty-credit:1",
  "title": "Loyalty points credit payload",
  "type": "object",
  "properties": {
    "channel": {
      "const": "channel.loyalty-credit"
    },
    "recipient": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "app_account_ref"
        },
        "app_id": {
          "enum": [
            "waypoint",
            "skyline",
            "harbor"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        }
      },
      "required": [
        "kind",
        "app_id",
        "id"
      ],
      "additionalProperties": false
    },
    "source_object": {
      "type": "object",
      "properties": {
        "app_id": {
          "const": "waypoint"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        },
        "object_type": {
          "enum": [
            "transfer",
            "combine"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        }
      },
      "required": [
        "app_id",
        "object_type",
        "object_id",
        "account_id"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "partner_transfer",
            "household_combine"
          ]
        },
        "member_person_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
        },
        "member_number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "base_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "bonus_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      },
      "required": [
        "kind",
        "member_person_id",
        "member_number",
        "points",
        "base_points",
        "bonus_pct"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "channel",
    "recipient",
    "source_object",
    "content",
    "extensions"
  ],
  "additionalProperties": false
}
