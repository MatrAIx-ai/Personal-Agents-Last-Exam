{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:skyline:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "member_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The program's member number, as printed on the account."
    },
    "mail_account_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "balance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "opening",
              "transfer_in",
              "redeem",
              "refund"
            ]
          },
          "points": {
            "type": "integer",
            "minimum": -100000000,
            "maximum": 100000000
          },
          "balance_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "booking_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "booking_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "app_id": {
                    "const": "waypoint"
                  },
                  "account_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "object_type": {
                    "enum": [
                      "transfer",
                      "combine"
                    ]
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "sent_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "app_id",
                  "account_id",
                  "object_type",
                  "object_id",
                  "message_id",
                  "sent_at"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "at",
          "kind",
          "points",
          "balance_after",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "payment_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Opaque payment label, one of the account payment_labels."
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque payment label, one of the account payment_labels."
          },
          "amount_cents": {
            "type": "integer",
            "minimum": -100000000,
            "maximum": 100000000
          },
          "currency": {
            "const": "USD"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "booking_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "booking_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "at",
          "label",
          "amount_cents",
          "currency",
          "description",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "kind": {
            "enum": [
              "booking_confirmed",
              "schedule_change"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "booking_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "change_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "booking_id",
                  "change_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "history",
          "kind",
          "title",
          "body",
          "ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "person_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Name as on the ticket."
          }
        },
        "required": [
          "id",
          "person_id",
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 9,
      "minItems": 1
    },
    "airports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter airport code."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "IANA time zone of the airport."
          }
        },
        "required": [
          "code",
          "city",
          "timezone"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "minItems": 2
    },
    "award_chart": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter airport code."
          },
          "dest": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter airport code."
          },
          "cabin": {
            "enum": [
              "business",
              "economy"
            ]
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "partner_fee_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "taxes_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "operating_carrier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Optional. This row prices any itinerary with a segment operated by this carrier; otherwise the row without a carrier applies."
          }
        },
        "required": [
          "origin",
          "dest",
          "cabin",
          "points",
          "partner_fee_cents",
          "taxes_cents"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "rules": {
      "type": "object",
      "properties": {
        "min_connection_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "max_connection_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880
        }
      },
      "required": [
        "min_connection_minutes",
        "max_connection_minutes"
      ],
      "additionalProperties": false
    },
    "flights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "flight_number": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2}[0-9]{1,4}$"
          },
          "operating_carrier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter airport code."
          },
          "dest": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter airport code."
          },
          "departs_at": {
            "type": "string",
            "format": "date-time",
            "description": "Local time at the origin airport."
          },
          "arrives_at": {
            "type": "string",
            "format": "date-time",
            "description": "Local time at the destination airport."
          },
          "cabins": {
            "type": "object",
            "properties": {
              "business": {
                "type": "object",
                "properties": {
                  "saver_seats": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "Award (saver) seats left for sale. Never more than the free seats."
                  },
                  "seats": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]?[A-K]$"
                    },
                    "maxItems": 120,
                    "uniqueItems": true,
                    "minItems": 1,
                    "description": "Every seat in the cabin, in assignment order."
                  },
                  "adjacent_pairs": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]?[A-K]$"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "maxItems": 120
                  },
                  "taken": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]?[A-K]$"
                    },
                    "maxItems": 120,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "saver_seats",
                  "seats",
                  "adjacent_pairs",
                  "taken"
                ],
                "additionalProperties": false
              },
              "economy": {
                "type": "object",
                "properties": {
                  "saver_seats": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "Award (saver) seats left for sale. Never more than the free seats."
                  },
                  "seats": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]?[A-K]$"
                    },
                    "maxItems": 120,
                    "uniqueItems": true,
                    "minItems": 1,
                    "description": "Every seat in the cabin, in assignment order."
                  },
                  "adjacent_pairs": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]?[A-K]$"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "maxItems": 120
                  },
                  "taken": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]?[A-K]$"
                    },
                    "maxItems": 120,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "saver_seats",
                  "seats",
                  "adjacent_pairs",
                  "taken"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "flight_number",
          "operating_carrier",
          "origin",
          "dest",
          "departs_at",
          "arrives_at",
          "cabins"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "inventory_revision": {
      "type": "integer",
      "minimum": 0
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "locator": {
            "type": "string",
            "pattern": "^[A-Z]{6}$"
          },
          "status": {
            "enum": [
              "ticketed",
              "cancelled"
            ]
          },
          "cabin": {
            "enum": [
              "business",
              "economy"
            ]
          },
          "passenger_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 9,
            "uniqueItems": true,
            "minItems": 1
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 4,
            "uniqueItems": true,
            "minItems": 1
          },
          "saver_flight_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 4,
            "uniqueItems": true,
            "description": "Segments on which this booking holds saver inventory."
          },
          "saver_reductions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "flight_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "seats": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                }
              },
              "required": [
                "flight_id",
                "seats"
              ],
              "additionalProperties": false
            },
            "maxItems": 4,
            "description": "Saver seats that this booking's non-saver seats (a free schedule-change alternative) pushed out of a flight's saver inventory. Owed by the flight and cabin: any seat release there gives saver seats back up to the free seats, paying the releasing booking's records first, then other bookings' in booking order."
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "flight_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "passenger_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "seat": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]?[A-K]$"
                }
              },
              "required": [
                "flight_id",
                "passenger_id",
                "seat"
              ],
              "additionalProperties": false
            },
            "maxItems": 36
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "partner_fee_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "taxes_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "payment_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque payment label, one of the account payment_labels."
          },
          "charge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "maxItems": 10,
            "uniqueItems": true
          },
          "change": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "change_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "reason": {
                    "enum": [
                      "illegal_connection",
                      "time_change"
                    ]
                  },
                  "flight_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  },
                  "replaces": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                    },
                    "maxItems": 4,
                    "uniqueItems": true,
                    "minItems": 1,
                    "description": "Booked segments an accepted alternative replaces."
                  },
                  "alternatives": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                        },
                        "flight_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                          },
                          "maxItems": 4,
                          "uniqueItems": true,
                          "minItems": 1
                        }
                      },
                      "required": [
                        "id",
                        "flight_ids"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 5
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "open",
                      "accepted",
                      "expired"
                    ]
                  },
                  "accepted_alternative_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "change_id",
                  "reason",
                  "flight_id",
                  "replaces",
                  "alternatives",
                  "deadline",
                  "status",
                  "accepted_alternative_id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "locator",
          "status",
          "cabin",
          "passenger_ids",
          "segments",
          "saver_flight_ids",
          "saver_reductions",
          "seats",
          "points",
          "partner_fee_cents",
          "taxes_cents",
          "payment_label",
          "charge_ids",
          "change",
          "created_at",
          "updated_at",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "member_number",
    "mail_account_id",
    "balance",
    "ledger",
    "payment_labels",
    "charges",
    "notices",
    "passengers",
    "airports",
    "award_chart",
    "rules",
    "flights",
    "inventory_revision",
    "bookings"
  ],
  "additionalProperties": false
}
