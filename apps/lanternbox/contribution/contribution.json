{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "lanternbox",
  "app_categories": [
    "external"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "lanternbox.account.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.plans.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.billing.history",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.profiles.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.profiles.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.catalog.search",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.titles.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.progress.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.history.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.watchlist.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.devices.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.notifications.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "lanternbox.watchlist.add",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.watchlist.remove",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.progress.set",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.history.hide",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.profiles.create",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.profiles.update",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.profiles.delete",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.devices.sign_out",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.plan.change",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.plan.cancel",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "lanternbox.plan.resume",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "Per-App lock and optimistic epoch/revision check",
    "commit_confirmation": "committed + epoch/revision; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "lanternbox.playback.recorded",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "lanternbox.catalog.title_added",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "lanternbox.catalog.episode_released",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "lanternbox.catalog.leaving_set",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "lanternbox.billing.charged",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "lanternbox.device.signed_in",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": false,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": "gui.json",
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [],
    "implemented_storage_adapters": [
      "storage.file",
      "storage.inline"
    ],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
