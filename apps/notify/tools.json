[
  {
    "name": "notify.reminder.create",
    "description": "Schedule a reminder on the user's phone. Give either fire_at, or all of calendar_account_id, calendar_event_id, event_start (read with calendar.get) and minutes_before to fire that long before a Calendar event. The time must be in the future. The reminder reaches the phone only when Infra delivers it at that time.",
    "read_only": false,
    "scope": "notify.reminder.create",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "fire_at": {
          "type": "string",
          "format": "date-time"
        },
        "calendar_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Calendar account of the event, exactly as calendar.get returns it."
        },
        "calendar_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Calendar event ID to anchor to, exactly as calendar.get returns it."
        },
        "event_start": {
          "type": "string",
          "format": "date-time",
          "description": "The event start as read with calendar.get. Notify does not read Calendar itself."
        },
        "minutes_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "actionable": {
          "type": "boolean"
        },
        "expected_version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        }
      },
      "required": [
        "title",
        "expected_version",
        "request_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "committed"
        },
        "app_id": {
          "const": "notify"
        },
        "version": {
          "type": "object",
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "epoch",
            "revision"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "fire_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "app_id",
        "version",
        "id",
        "fire_at"
      ],
      "additionalProperties": false
    }
  },
