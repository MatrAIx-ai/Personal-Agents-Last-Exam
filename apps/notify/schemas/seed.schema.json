{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:notify:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "device": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone used to evaluate focus windows, for example America/Chicago."
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "days": {
                "type": "array",
                "items": {
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                },
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "description": "Days on which the window starts. A window whose end is not after its start runs past midnight into the next day."
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Local wall-clock time HH:MM in the device time zone."
              },
              "end": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Local wall-clock time HH:MM in the device time zone."
              }
            },
            "required": [
              "id",
              "label",
              "days",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "silence_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "at",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "timezone",
        "focus",
        "silence_until",
        "updated_at",
        "history"
      ],
      "additionalProperties": false
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "fire_at": {
            "type": "string",
            "format": "date-time"
          },
          "anchor": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "calendar_event_ref": {
                    "type": "object",
                    "properties": {
                      "app_id": {
                        "const": "calendar"
                      },
                      "account_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "event_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      }
                    },
                    "required": [
                      "app_id",
                      "account_id",
                      "event_id"
                    ],
                    "additionalProperties": false
                  },
                  "event_start": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Event start as read with calendar.get when the reminder was set. Notify does not read Calendar itself."
                  },
                  "minutes_before": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10080
                  }
                },
                "required": [
                  "calendar_event_ref",
                  "event_start",
                  "minutes_before"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "actionable": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "scheduled",
              "delivered",
              "silenced",
              "cancelled"
            ]
          },
          "fired_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "feed_item_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "account_id",
          "created_at",
          "updated_at",
          "history",
          "title",
          "body",
          "fire_at",
          "anchor",
          "actionable",
          "status",
          "fired_at",
          "feed_item_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "feed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "reminder"
                  },
                  "reminder_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                  }
                },
                "required": [
                  "kind",
                  "reminder_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "push"
                  },
                  "app_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "account_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "object_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                  },
                  "message_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  }
                },
                "required": [
                  "kind",
                  "app_id",
                  "account_id",
                  "object_type",
                  "object_id",
                  "message_id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "actionable": {
            "type": "boolean"
          },
          "deep_link": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "arrived_at": {
            "type": "string",
            "format": "date-time"
          },
          "delivery": {
            "enum": [
              "delivered",
              "silenced"
            ]
          },
          "read_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "dismissed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "account_id",
          "created_at",
          "updated_at",
          "history",
          "source",
          "title",
          "body",
          "actionable",
          "deep_link",
          "sent_at",
          "arrived_at",
          "delivery",
          "read_at",
          "dismissed_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "device",
    "reminders",
    "feed"
  ],
  "additionalProperties": false
}
