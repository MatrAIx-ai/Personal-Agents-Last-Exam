{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pale:calendar:seed:1",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "owner_person_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "calendar_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "calendar_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "organizer_person_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "uniqueItems": true
          },
          "location": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "cancelled"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "uid",
          "account_id",
          "calendar_id",
          "title",
          "start",
          "end",
          "timezone",
          "organizer_person_id",
          "attendees",
          "location",
          "status",
          "sequence"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "calendar_id",
    "timezone",
    "events"
  ],
  "additionalProperties": false
}
