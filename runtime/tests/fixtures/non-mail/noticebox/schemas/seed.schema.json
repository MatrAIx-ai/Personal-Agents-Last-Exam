{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "owner_person_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "text",
          "timestamp"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "items"
  ],
  "additionalProperties": false
}
