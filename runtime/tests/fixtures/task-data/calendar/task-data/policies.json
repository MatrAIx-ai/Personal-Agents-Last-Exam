{
  "scenario": {
    "allow": [
      "calendar.list",
      "calendar.get",
      "calendar.freebusy",
      "calendar.update",
      "calendar.export_ics"
    ],
    "constraints": {
      "calendar.update": {
        "ids": [
          "evt-review"
        ],
        "fields": [
          "start",
          "end"
        ]
      }
    }
  },
  "sandbox": {
    "allow": [
      "calendar.list",
      "calendar.get",
      "calendar.freebusy",
      "calendar.create",
      "calendar.update",
      "calendar.cancel",
      "calendar.export_ics"
    ],
    "constraints": {}
  }
}
