{
  "id": "local-reference-v1",
  "transports": [
    "mcp.stdio"
  ],
  "gui_audiences": [
    "reviewer"
  ],
  "storage_adapters": [
    "storage.file",
    "storage.inline"
  ],
  "max_assets": 64,
  "max_bundle_bytes": 1048576,
  "mime_types": [
    "image/png",
    "image/jpeg",
    "audio/mpeg",
    "audio/wav",
    "video/mp4",
    "application/json",
    "application/pdf",
    "text/plain",
    "text/calendar"
  ]
}
