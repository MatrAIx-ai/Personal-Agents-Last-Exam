{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "app_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "path": {
            "type": "string",
            "pattern": "^[^/].*"
          }
        },
        "required": [
          "app_id",
          "version",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "initial_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "apps"
  ],
  "additionalProperties": false
}
